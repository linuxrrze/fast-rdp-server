        <mxCell id="c2" value="&lt;b&gt;fastrdp architecture overview&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#1a1a1a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;RDP clients&lt;/b&gt;&lt;br&gt;mstsc · xfreerdp3 · Remmina" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Kerberos KDC&lt;/b&gt;&lt;br&gt;Samba AD / FreeIPA / MIT&lt;br&gt;tickets for TERMSRV/&amp;lt;fqdn&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Web browser / phone&lt;/b&gt;&lt;br&gt;web path · approval page&lt;br&gt;(optional)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="c6" value="ticket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#1a1a1a;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c7" value="RDP host · Ubuntu 26.04 / Debian 13 · reachable from the network: only :3389 (and :443 with web access)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fillColor=#fbfbfb;strokeColor=#4d4d4d;fontColor=#1a1a1a;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1000" height="800" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;freerdp-proxy + fastrdp module&lt;/b&gt;&lt;br&gt;user _fastrdp-proxy · TCP 3389&lt;br&gt;TLS, NLA (Kerberos keytab), credential swap&lt;hr&gt;waiting screen in the RDP window:&lt;br&gt;MFA prompt · login code · QR code&lt;br&gt;desktop picker" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="c7"><mxGeometry x="40" y="50" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Web path&lt;/b&gt;&lt;br&gt;nginx :443 → fastrdp-webgate →&lt;br&gt;Guacamole / guacd (loopback)&lt;hr&gt;/web/approve: approve RDP logins&lt;br&gt;/web/notify: notifications opt-in" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="c7"><mxGeometry x="680" y="50" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;fastrdp-brokerd&lt;/b&gt; (root)&lt;br&gt;/run/fastrdp/broker.sock&lt;br&gt;PAM account (SSSD, AD GPO) · allow_groups · MFA (KDC evidence, push, web approval) · desktop choice · one-time tokens" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="c7"><mxGeometry x="40" y="240" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="c11" value="Loopback only · 127.0.0.1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fillColor=#f3f9f1;strokeColor=#82b366;fontColor=#1a1a1a;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;dashed=1;dashPattern=6 4;" vertex="1" parent="c7"><mxGeometry x="40" y="400" width="920" height="350" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;xrdp 0.10.6.1 + xorgxrdp&lt;/b&gt;&lt;br&gt;127.0.0.1:3390 · TLS&lt;br&gt;user + one-time token&lt;br&gt;(pam_fastrdp_token in xrdp-sesman)&lt;hr&gt;Xfce · MATE · Cinnamon · LXQt · Plasma X11&lt;br&gt;Sway · labwc · Wayfire nested (wlroots-in-x)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="c11"><mxGeometry x="20" y="40" width="280" height="200" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;GNOME 50+&lt;/b&gt;&lt;br&gt;GDM gnome-headless-session@USER&lt;br&gt;+ gnome-remote-desktop (headless)&lt;hr&gt;127.0.0.1:339xx · NLA&lt;br&gt;broker-generated random secret" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="c11"><mxGeometry x="320" y="40" width="280" height="200" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;Plasma 6 (Wayland)&lt;/b&gt;&lt;br&gt;fastrdp-plasma@USER:&lt;br&gt;kwin_wayland --virtual + krdpserver&lt;hr&gt;127.0.0.1:339xx · NLA&lt;br&gt;broker-generated random secret" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="c11"><mxGeometry x="620" y="40" width="280" height="200" as="geometry"/></mxCell>
        <mxCell id="c15" value="nftables: back-end ports dropped on non-loopback interfaces; on loopback only _fastrdp-proxy and root may open connections (meta skuid). The broker checks in /proc/net/tcp that the expected uid holds the port." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=middle;fontColor=#3d6b30;" vertex="1" parent="c11"><mxGeometry x="20" y="260" width="880" height="60" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;OIDC, MFA via acr/amr&lt;br&gt;(passkey, OTP, WebAuthn,&lt;br&gt;privacyIDEA)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="240" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;privacyIDEA&lt;/b&gt;&lt;br&gt;push (app on the phone)&lt;br&gt;TOTP/HOTP · YubiKey OTP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="445" width="210" height="110" as="geometry"/></mxCell>
