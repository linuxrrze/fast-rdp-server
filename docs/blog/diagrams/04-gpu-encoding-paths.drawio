        <mxCell id="c33" value="&lt;b&gt;freerdp-proxy&lt;/b&gt;&lt;br&gt;&lt;br&gt;passes GFX / H.264 through without decoding&lt;br&gt;&lt;br&gt;measured: ~0.3–0.5 % of one core per Mbit/s (TLS re-encryption), no fps loss" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1050" y="100" width="150" height="480" as="geometry"/></mxCell>
