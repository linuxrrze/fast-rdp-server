        <mxCell id="c9" value="glamor on Intel/AMD&lt;br&gt;NVIDIA: VirtualGL (vglrun)&lt;br&gt;wlroots: GLES via DRI3,&lt;br&gt;else pixman · no GPU: software" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="c7"><mxGeometry x="150" y="25" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="c10" value="fastrdp FFmpeg patch&lt;br&gt;(runs in the xrdp daemon)&lt;br&gt;h264_vaapi · h264_nvenc · h264_qsv&lt;br&gt;→ H.264 AVC420" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="c7"><mxGeometry x="420" y="25" width="250" height="100" as="geometry"/></mxCell>
