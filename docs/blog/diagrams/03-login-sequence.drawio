        <mxCell id="c63" value="Smartcard users get their TGT by PKINIT before step 1 (the PIN is never forwarded). TLS logins can append an OTP instead. Web logins (Guacamole) prove MFA at Keycloak and skip steps 7–22." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1844" width="1300" height="24" as="geometry"/></mxCell>
