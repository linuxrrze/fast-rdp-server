        <mxCell id="c59" value="27 · RDP with swapped credentials" style="html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#4d4d4d;strokeWidth=1.5;fontColor=#1a1a1a;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="379" y="1670" as="sourcePoint"/><mxPoint x="673" y="1670" as="targetPoint"/></mxGeometry></mxCell>
