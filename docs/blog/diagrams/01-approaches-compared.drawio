<mxfile host="drawio" agent="fastrdp blog generator" version="24.7.17">
  <diagram id="approaches-compared" name="approaches-compared">
    <mxGraphModel dx="1370" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1370" pageHeight="780" math="0" shadow="0" background="#ffffff" adaptiveColors="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b&gt;Approaches to a multi-user Linux RDP terminal server&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#1a1a1a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="c3" value="Status as of October 2026 · ✔ covered · ◐ partly · ✘ not covered · – not evaluated · fastrdp column: implemented and tested in CI / sandbox; back-ends and GPU paths still need lab validation" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1330" height="22" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;(a) xrdp alone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;One X11 server (xrdp 0.10.x + xorgxrdp) for every user&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="75" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;(b) Native per-desktop servers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;gnome-remote-desktop for GNOME, KRdp for Plasma, each on its own&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="75" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;(c) ogon-style broker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Broker in front of per-user sessions (ogon, dormant since ~2019)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="75" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;(d) fastrdp hybrid&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;freerdp-proxy + module → broker → native back-end per desktop family&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="75" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;X11 desktops&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="167" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="c9" value="✔ Xfce, MATE, Cinnamon, LXQt, Plasma X11" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="167" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c10" value="✘ Wayland session servers only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="167" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c11" value="–" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="167" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c12" value="✔ via xrdp 0.10.6.1 (fastrdp build)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="167" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;Wayland desktops&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="245" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="c14" value="✘ GNOME 50 / Plasma 6.8 are Wayland-only; xorgxrdp cannot host them" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="245" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c15" value="◐ GNOME and Plasma only; wlroots has no RDP server (wayvnc = VNC)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="245" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c16" value="–" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="245" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c17" value="✔ GNOME, Plasma, Sway/labwc/Wayfire (nested in xrdp) · lab validation pending" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="245" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;NLA / Kerberos SSO&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="323" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="c19" value="✘ no NLA in any release (PR #3868 open)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="323" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c20" value="◐ per server (g-r-d: NLA + Kerberos keytab), configured separately" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="323" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c21" value="–" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="323" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c22" value="✔ once, at the proxy (incl. smartcard via PKINIT)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="323" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;MFA&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="401" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="c24" value="◐ only through PAM at the xrdp login dialog" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="401" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c25" value="✘ no common place to enforce it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="401" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c26" value="–" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="401" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c27" value="✔ privacyIDEA push / OTP / YubiKey OTP; Keycloak on the web" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="401" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;GPU H.264 encoding&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="479" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="c29" value="✘ x264 / OpenH264 on the CPU (GPU rendering via glamor only)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="479" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c30" value="✔ g-r-d VA-API / NVENC; KRdp VA-API (CPU x264 on NVIDIA)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="479" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c31" value="–" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="479" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c32" value="◐ best encoder per back-end; xrdp via fastrdp FFmpeg patch · not yet on real GPUs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="479" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;Multi-user sessions&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="557" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="c34" value="✔ per-user X sessions via xrdp-sesman" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="557" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c35" value="◐ g-r-d headless via GDM; KRdp officially shares an existing session" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="557" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c36" value="✔ the broker model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="557" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c37" value="✔ broker starts / reuses one session per user and back-end" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="557" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;Maintained&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="635" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="c39" value="✔" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="635" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c40" value="✔" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="635" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c41" value="✘ dormant since ~2019" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="635" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c42" value="✔ built from maintained parts + small glue" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="635" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c43" value="Also considered: VNC exporters such as wayvnc for wlroots compositors. A VNC hop loses H.264 and the GPU path, so fastrdp nests Sway, labwc and Wayfire inside an xrdp session instead. Hyprland is not supported (no X11 backend)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="717" width="1330" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
