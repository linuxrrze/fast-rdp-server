# {{ ansible_managed }}
[sssd]
domains = {{ fastrdp_domain }}
services = nss, pam

[pam]
offline_credentials_expiration = 1

[domain/{{ fastrdp_domain }}]
id_provider = ad
access_provider = ad
ad_domain = {{ fastrdp_domain }}
krb5_realm = {{ fastrdp_realm }}
realmd_tags = manages-system joined-with-adcli
cache_credentials = true
krb5_store_password_if_offline = true
default_shell = /bin/bash
ldap_id_mapping = true
# fastrdp_sssd_fully_qualified_names: "alice@{{ fastrdp_domain }}" instead of "alice".
use_fully_qualified_names = {{ fastrdp_sssd_fully_qualified_names | bool | lower }}
# %u is the short name in both modes: switching keeps the home directories. Only for
# users without unixHomeDirectory in AD (that one wins).
fallback_homedir = /home/%u
# Terminal-server sessions run for days: keep session TGTs renewed.
krb5_renewable_lifetime = {{ fastrdp_krb5_renewable_lifetime }}
krb5_renew_interval = {{ fastrdp_krb5_renew_interval }}
# Treat the RDP PAM services like Windows RDS ("Allow log on through Remote Desktop Services").
ad_gpo_access_control = {{ fastrdp_ad_gpo_access_control }}
ad_gpo_map_remote_interactive = +fastrdp, +xrdp-sesman, +fastrdp-session
ad_maximum_machine_account_password_age = 30
