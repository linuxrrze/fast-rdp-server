# {{ ansible_managed }}
# Paths only in the access log: query strings carry OIDC codes and Guacamole data blobs.
log_format fastrdp_web '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ ansible_fqdn }};
    ssl_certificate     /etc/fastrdp/front.crt;
    ssl_certificate_key /etc/fastrdp/front.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/fastrdp-web.log fastrdp_web;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy no-referrer always;

    location = / { return 302 /web/; }

    location /web/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /guacamole/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ ansible_fqdn }};
    access_log /var/log/nginx/fastrdp-web.log fastrdp_web;
    return 301 https://$host$request_uri;
}
