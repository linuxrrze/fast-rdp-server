# {{ ansible_managed }}
# GFX pipeline codecs for xrdp, see gfx.toml(5). H.264 first (AVC420/444), RFX fallback.
[codec]
order = [ "H.264", "RFX" ]
h264_encoder = "x264"

[x264.default]
preset = "{{ fastrdp_x264_preset }}"
tune = "zerolatency"
profile = "main"
vbv_max_bitrate = 0
vbv_buffer_size = 0
fps_num = {{ fastrdp_x264_fps }}
fps_den = 1
threads = {{ fastrdp_x264_threads }}

# Per connection type (client "network:" setting / autodetect)
[x264.lan]

[x264.wan]
vbv_max_bitrate = 15_000
vbv_buffer_size = 1_500

[x264.broadband_high]
preset = "superfast"
vbv_max_bitrate = 8_000
vbv_buffer_size = 800

[x264.satellite]
preset = "superfast"
vbv_max_bitrate = 5_000
vbv_buffer_size = 500

[x264.broadband_low]
preset = "veryfast"
vbv_max_bitrate = 1_600
vbv_buffer_size = 66

[x264.modem]
preset = "fast"
vbv_max_bitrate = 1_200
vbv_buffer_size = 50
