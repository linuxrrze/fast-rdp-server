# {{ ansible_managed }}
# GFX pipeline codecs for xrdp, see gfx.toml(5). H.264 first (AVC420), RFX fallback.
{#
  Per connection type ([MS-RDPBCGR] 2.2.1.3.2) encoder profiles, one place for both
  encoders. Values are TOML literals; an empty profile inherits [*.default].
#}
{% set profiles = {
  'lan': {'ffmpeg': {}, 'x264': {}},
  'wan': {'ffmpeg': {'bitrate': '12_000', 'max_bitrate': '15_000'},
          'x264': {'vbv_max_bitrate': '15_000', 'vbv_buffer_size': '1_500'}},
  'broadband_high': {'ffmpeg': {'bitrate': '6_000', 'max_bitrate': '8_000'},
                     'x264': {'preset': '"superfast"', 'vbv_max_bitrate': '8_000', 'vbv_buffer_size': '800'}},
  'satellite': {'ffmpeg': {'bitrate': '4_000', 'max_bitrate': '5_000'},
                'x264': {'preset': '"superfast"', 'vbv_max_bitrate': '5_000', 'vbv_buffer_size': '500'}},
  'broadband_low': {'ffmpeg': {'bitrate': '1_400', 'max_bitrate': '1_600'},
                    'x264': {'preset': '"veryfast"', 'vbv_max_bitrate': '1_600', 'vbv_buffer_size': '66'}},
  'modem': {'ffmpeg': {'bitrate': '1_000', 'max_bitrate': '1_200'},
            'x264': {'preset': '"fast"', 'vbv_max_bitrate': '1_200', 'vbv_buffer_size': '50'}},
  'default': {'ffmpeg': {}, 'x264': {}},
} %}
{% set autodetect = profiles[fastrdp_xrdp_autodetect_profile] %}
{% macro sections(encoder) %}
{% for name in ['lan', 'wan', 'broadband_high', 'satellite', 'broadband_low', 'modem'] %}

[{{ encoder }}.{{ name }}]
{% for key, value in profiles[name][encoder].items() %}
{{ key }} = {{ value }}
{% endfor %}
{% endfor %}

# Auto-detect (type 7, mstsc's default) = the {{ fastrdp_xrdp_autodetect_profile }} profile
# (fastrdp_xrdp_autodetect_profile). xrdp 0.10.6.1 does not read this section: it
# encodes type 7 like lan. The proxy therefore sends xrdp the profile's own type instead
# (broker.toml [network]); this copy keeps an xrdp that honours it consistent.
[{{ encoder }}.autodetect]
{% for key, value in autodetect[encoder].items() %}
{{ key }} = {{ value }}
{% endfor %}
{% endmacro %}
[codec]
order = [ "H.264", "RFX" ]
{% set enc = fastrdp_xrdp_h264_encoder_effective %}
{% if enc == 'x264' %}
h264_encoder = "x264"
{% else %}
# FFmpeg hardware encoder (fastrdp xrdp patch); falls back to libx264 at start-up
# if the GPU, driver or library is not usable.
h264_encoder = "ffmpeg"

[ffmpeg]
encoder = "h264_{{ enc }}"
device = "{{ fastrdp_xorgxrdp_drm_device }}"
fallback = "libx264"

[ffmpeg.default]
qp = {{ fastrdp_ffmpeg_qp }}
gop = {{ fastrdp_ffmpeg_gop }}
fps_num = {{ fastrdp_x264_fps }}
fps_den = 1
{{ sections('ffmpeg') }}
{%- endif %}

# x264: always configured, it is also the software path when H.264 is x264
[x264.default]
preset = "{{ fastrdp_x264_preset }}"
tune = "zerolatency"
profile = "main"
vbv_max_bitrate = 0
vbv_buffer_size = 0
fps_num = {{ fastrdp_x264_fps }}
fps_den = 1
threads = {{ fastrdp_x264_threads }}

# Per connection type (client "network:" setting, or the broker's choice for auto-detect)
{{ sections('x264') }}
