 xrdp/xrdp_tconfig.c        | 116 ++++++++
 xrdp/xrdp_tconfig.h        |  26 +-
 8 files changed, 744 insertions(+), 7 deletions(-)
 create mode 100644 xrdp/xrdp_encoder_ffmpeg.c
 create mode 100644 xrdp/xrdp_encoder_ffmpeg.h

