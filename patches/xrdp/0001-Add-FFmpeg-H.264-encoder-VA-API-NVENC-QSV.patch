diff --git a/xrdp/xrdp_encoder_ffmpeg.c b/xrdp/xrdp_encoder_ffmpeg.c
new file mode 100644
index 0000000..316d967
--- /dev/null
+++ b/xrdp/xrdp_encoder_ffmpeg.c
@@ -0,0 +1,529 @@
+/**
+ * xrdp: A Remote Desktop Protocol server.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ * H.264 encoding through FFmpeg's libavcodec: hardware encoders
+ * (h264_vaapi on Intel/AMD, h264_nvenc on NVIDIA, h264_qsv on Intel) and,
+ * for testing, libx264. Input is the NV12 frame xorgxrdp already produces
+ * for the x264 module; output is one Annex B access unit per call (no
+ * B-frames, no lookahead, SPS/PPS repeated on IDR frames).
+ */
+
+#if defined(HAVE_CONFIG_H)
+#include <config_ac.h>
+#endif
+
+#include <string.h>
+
+#include <libavcodec/avcodec.h>
+#include <libavutil/dict.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/opt.h>
+#include <libavutil/pixdesc.h>
+
+#include "xrdp.h"
+#include "arch.h"
+#include "os_calls.h"
+#include "string_calls.h"
+#include "xrdp_encoder_ffmpeg.h"
+#include "xrdp_tconfig.h"
+
+#define FFMPEG_MAX_ENCODERS 16
+
+struct ffmpeg_encoder
+{
+    AVCodecContext *ctx;
+    AVBufferRef *hw_frames;
+    AVFrame *sw;            /* persistent full frame (NV12), damaged rects copied in */
+    AVPacket *pkt;
+    int width;              /* requested size */
+    int height;
+    int64_t pts;
+    int force_idr;          /* output was lost: the next frame must be an IDR */
+};
+
+struct ffmpeg_global
+{
+    struct ffmpeg_encoder encoders[FFMPEG_MAX_ENCODERS];
+    struct xrdp_tconfig_gfx_ffmpeg_global global;
+    struct xrdp_tconfig_gfx_ffmpeg_param param[NUM_CONNECTION_TYPES];
+    AVBufferRef *hw_device;
+    int is_vaapi;
+};
+
+/* Low-latency defaults per encoder; gfx.toml [ffmpeg] options override them. */
+static const struct
+{
+    const char *encoder;
+    const char *options;
+} g_defaults[] =
+{
+    { "h264_vaapi", "async_depth=1:profile=main" },
+    { "h264_nvenc", "preset=p1:tune=ull:zerolatency=1:delay=0:profile=main:forced-idr=1" },
+    { "h264_qsv", "async_depth=1:preset=veryfast:look_ahead=0:profile=main:forced_idr=1" },
+    { "libx264", "preset=ultrafast:tune=zerolatency:profile=main:forced-idr=1" },
+};
+
+/*****************************************************************************/
+static void
+ffmpeg_log_error(const char *what, int err)
+{
+    char buf[AV_ERROR_MAX_STRING_SIZE];
+    av_strerror(err, buf, sizeof(buf));
+    LOG(LOG_LEVEL_ERROR, "xrdp_encoder_ffmpeg: %s: %s", what, buf);
+}
+
+/*****************************************************************************/
+static void
+ffmpeg_encoder_close(struct ffmpeg_encoder *fe)
+{
+    avcodec_free_context(&fe->ctx);
+    av_buffer_unref(&fe->hw_frames);
+    av_frame_free(&fe->sw);
+    av_packet_free(&fe->pkt);
+    fe->pts = 0;
+    fe->force_idr = 0;
+}
+
+/*****************************************************************************/
+/* Options: encoder defaults, then [ffmpeg] options, then [ffmpeg.<ct>] options */
+static int
+ffmpeg_build_options(struct ffmpeg_global *fg, const struct xrdp_tconfig_gfx_ffmpeg_param *p,
+                     AVDictionary **dict)
+{
+    unsigned int i;
+    for (i = 0; i < sizeof(g_defaults) / sizeof(g_defaults[0]); i++)
+    {
+        if (strcmp(g_defaults[i].encoder, fg->global.encoder) == 0)
+        {
+            av_dict_parse_string(dict, g_defaults[i].options, "=", ":", 0);
+        }
+    }
+    if (fg->global.options[0] != '\0' &&
+            av_dict_parse_string(dict, fg->global.options, "=", ":", 0) < 0)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_encoder_ffmpeg: bad [ffmpeg] options \"%s\"",
+            fg->global.options);
+        return 1;
+    }
+    if (p->options[0] != '\0' &&
+            av_dict_parse_string(dict, p->options, "=", ":", 0) < 0)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_encoder_ffmpeg: bad options \"%s\"", p->options);
+        return 1;
+    }
+    return 0;
+}
+
+/*****************************************************************************/
+static int
+ffmpeg_encoder_open(struct ffmpeg_global *fg, struct ffmpeg_encoder *fe,
+                    int width, int height, int ct)
+{
+    const struct xrdp_tconfig_gfx_ffmpeg_param *p = &fg->param[ct];
+    const AVCodec *codec;
+    AVDictionary *dict = NULL;
+    AVDictionaryEntry *left = NULL;
+    int err;
+
+    codec = avcodec_find_encoder_by_name(fg->global.encoder);
+    if (codec == NULL)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_encoder_ffmpeg: encoder \"%s\" not found "
+            "in libavcodec", fg->global.encoder);
+        return 1;
+    }
+    fe->ctx = avcodec_alloc_context3(codec);
+    fe->sw = av_frame_alloc();
+    fe->pkt = av_packet_alloc();
+    if (fe->ctx == NULL || fe->sw == NULL || fe->pkt == NULL)
+    {
+        return 2;
+    }
+
+    /* Same geometry as the x264 module: macroblock-aligned, the client crops */
+    fe->ctx->width = (width + 15) & ~15;
+    fe->ctx->height = (height + 15) & ~15;
+    fe->ctx->time_base = (AVRational) { p->fps_den, p->fps_num };
+    fe->ctx->framerate = (AVRational) { p->fps_num, p->fps_den };
+    fe->ctx->gop_size = p->gop;
+    fe->ctx->max_b_frames = 0;
+    fe->ctx->flags |= AV_CODEC_FLAG_LOW_DELAY;
+    /* xorgxrdp delivers full-range BT.709 NV12 (XRDP_nv12_709fr), the colour
+     * conversion MS-RDPEGFX 3.3.8.3.1 prescribes; say so in the VUI */
+    fe->ctx->color_range = AVCOL_RANGE_JPEG;
+    fe->ctx->colorspace = AVCOL_SPC_BT709;
+    fe->ctx->color_primaries = AVCOL_PRI_BT709;
+    fe->ctx->color_trc = AVCOL_TRC_BT709;
+    if (p->bitrate > 0)
+    {
+        fe->ctx->bit_rate = (int64_t)p->bitrate * 1000;
+        fe->ctx->rc_max_rate = (int64_t)(p->max_bitrate > 0 ? p->max_bitrate : p->bitrate) * 1000;
+        /* one frame interval worth of buffer: low latency, smooth enough */
+        fe->ctx->rc_buffer_size = (int)(fe->ctx->rc_max_rate * p->fps_den / p->fps_num);
+    }
+    else if (p->qp > 0)
+    {
+        fe->ctx->global_quality = p->qp; /* CQP/ICQ for vaapi and qsv */
+        if (strcmp(fg->global.encoder, "h264_nvenc") == 0)
+        {
+            av_dict_set(&dict, "rc", "constqp", 0);
+            av_dict_set_int(&dict, "qp", p->qp, 0);
+        }
+        else if (strcmp(fg->global.encoder, "libx264") == 0)
+        {
+            av_dict_set_int(&dict, "qp", p->qp, 0);
+        }
+    }
+
+    if (fg->is_vaapi)
+    {
+        AVHWFramesContext *frames;
+        fe->hw_frames = av_hwframe_ctx_alloc(fg->hw_device);
+        if (fe->hw_frames == NULL)
+        {
+            av_dict_free(&dict);
+            return 2;
+        }
+        frames = (AVHWFramesContext *)fe->hw_frames->data;
+        frames->format = AV_PIX_FMT_VAAPI;
+        frames->sw_format = AV_PIX_FMT_NV12;
+        frames->width = fe->ctx->width;
+        frames->height = fe->ctx->height;
+        frames->initial_pool_size = 4;
+        if ((err = av_hwframe_ctx_init(fe->hw_frames)) < 0)
+        {
+            ffmpeg_log_error("av_hwframe_ctx_init", err);
+            av_dict_free(&dict);
+            return 1;
+        }
+        fe->ctx->pix_fmt = AV_PIX_FMT_VAAPI;
+        fe->ctx->hw_frames_ctx = av_buffer_ref(fe->hw_frames);
+    }
+    else
+    {
+        fe->ctx->pix_fmt = AV_PIX_FMT_NV12;
+    }
+
+    if (ffmpeg_build_options(fg, p, &dict) != 0)
+    {
+        av_dict_free(&dict);
+        return 1;
+    }
+    err = avcodec_open2(fe->ctx, codec, &dict);
+    while ((left = av_dict_get(dict, "", left, AV_DICT_IGNORE_SUFFIX)) != NULL)
+    {
+        LOG(LOG_LEVEL_WARNING, "xrdp_encoder_ffmpeg: %s ignored option %s=%s",
+            fg->global.encoder, left->key, left->value);
+    }
+    av_dict_free(&dict);
+    if (err < 0)
+    {
+        ffmpeg_log_error("avcodec_open2", err);
+        return 1;
+    }
+
+    fe->sw->format = AV_PIX_FMT_NV12;
+    fe->sw->width = fe->ctx->width;
+    fe->sw->height = fe->ctx->height;
+    if ((err = av_frame_get_buffer(fe->sw, 0)) < 0)
+    {
+        ffmpeg_log_error("av_frame_get_buffer", err);
+        return 2;
+    }
+    /* black: Y=0, UV=128 (full range) */
+    for (int y = 0; y < fe->sw->height; y++)
+    {
+        g_memset(fe->sw->data[0] + y * fe->sw->linesize[0], 0, fe->sw->width);
+    }
+    for (int y = 0; y < fe->sw->height / 2; y++)
+    {
+        g_memset(fe->sw->data[1] + y * fe->sw->linesize[1], 128, fe->sw->width);
+    }
+    fe->width = width;
+    fe->height = height;
+    LOG(LOG_LEVEL_INFO, "xrdp_encoder_ffmpeg: %s opened for %dx%d (coded %dx%d)",
+        fg->global.encoder, width, height, fe->ctx->width, fe->ctx->height);
+    return 0;
+}
+
+/*****************************************************************************/
+/* Select an encoder and prove it works with one small encode, so a missing
+ * GPU, driver or library is noticed once here and not on every frame. */
+static int
+ffmpeg_select(struct ffmpeg_global *fg, const char *encoder)
+{
+    char out[64 * 1024];
+    int out_bytes = sizeof(out);
+    short rect[4] = { 0, 0, 256, 256 };
+    char *nv12;
+    int err;
+    int rv;
+
+    av_buffer_unref(&fg->hw_device);
+    g_strncpy(fg->global.encoder, encoder, sizeof(fg->global.encoder) - 1);
+    fg->is_vaapi = strstr(encoder, "vaapi") != NULL;
+    if (fg->is_vaapi)
+    {
+        err = av_hwdevice_ctx_create(&fg->hw_device, AV_HWDEVICE_TYPE_VAAPI,
+                                     fg->global.device[0] ? fg->global.device : NULL,
+                                     NULL, 0);
+        if (err < 0)
+        {
+            ffmpeg_log_error("VA-API device", err);
+            return 1;
+        }
+    }
+
+    nv12 = g_new0(char, 256 * 256 * 3 / 2);
+    if (nv12 == NULL)
+    {
+        return 1;
+    }
+    /* All slots are empty at creation: encode through slot 0, then release it. */
+    rv = xrdp_encoder_ffmpeg_encode(fg, 0, 0, 0, 256, 256, 256, 256, 0, nv12,
+                                    rect, 1, out, &out_bytes, CONNECTION_TYPE_LAN, NULL);
+    ffmpeg_encoder_close(&fg->encoders[0]);
+    fg->encoders[0].width = 0;
+    fg->encoders[0].height = 0;
+    g_free(nv12);
+    if (rv != 0)
+    {
+        av_buffer_unref(&fg->hw_device);
+    }
+    return rv;
+}
+
+/*****************************************************************************/
+void *
+xrdp_encoder_ffmpeg_create(void)
+{
+    struct ffmpeg_global *fg;
+    struct xrdp_tconfig_gfx gfxconfig;
+    char wanted[32];
+
+    fg = g_new0(struct ffmpeg_global, 1);
+    if (fg == NULL)
+    {
+        return NULL;
+    }
+    tconfig_load_gfx(GFX_CONF, &gfxconfig);
+    fg->global = gfxconfig.ffmpeg_global;
+    memcpy(fg->param, gfxconfig.ffmpeg_param, sizeof(fg->param));
+    g_strncpy(wanted, fg->global.encoder, sizeof(wanted) - 1);
+
+    if (ffmpeg_select(fg, wanted) != 0)
+    {
+        if (fg->global.fallback[0] == '\0' ||
+                strcmp(fg->global.fallback, wanted) == 0)
+        {
+            LOG(LOG_LEVEL_ERROR, "xrdp_encoder_ffmpeg: %s is not usable and no "
+                "fallback is configured", wanted);
+            g_free(fg);
+            return NULL;
+        }
+        LOG(LOG_LEVEL_WARNING, "xrdp_encoder_ffmpeg: %s is not usable on this "
+            "host, falling back to %s", wanted, fg->global.fallback);
+        /* the configured options were meant for the hardware encoder */
+        fg->global.options[0] = '\0';
+        if (ffmpeg_select(fg, fg->global.fallback) != 0)
+        {
+            LOG(LOG_LEVEL_ERROR, "xrdp_encoder_ffmpeg: fallback %s is not usable "
+                "either", fg->global.fallback);
+            g_free(fg);
+            return NULL;
+        }
+    }
+    LOG(LOG_LEVEL_INFO, "xrdp_encoder_ffmpeg: using %s%s%s", fg->global.encoder,
+        fg->is_vaapi ? " on " : "", fg->is_vaapi ? fg->global.device : "");
+    return fg;
+}
+
+/*****************************************************************************/
+int
+xrdp_encoder_ffmpeg_delete(void *handle)
+{
+    struct ffmpeg_global *fg = (struct ffmpeg_global *)handle;
+    int index;
+
+    if (fg == NULL)
+    {
+        return 0;
+    }
+    for (index = 0; index < FFMPEG_MAX_ENCODERS; index++)
+    {
+        ffmpeg_encoder_close(&fg->encoders[index]);
+    }
+    av_buffer_unref(&fg->hw_device);
+    g_free(fg);
+    return 0;
+}
+
+/*****************************************************************************/
+static int
+ffmpeg_drain(struct ffmpeg_encoder *fe, char *cdata, int *cdata_bytes)
+{
+    int total = 0;
+    int err;
+
+    while ((err = avcodec_receive_packet(fe->ctx, fe->pkt)) == 0)
+    {
+        if (total + fe->pkt->size > *cdata_bytes)
+        {
+            av_packet_unref(fe->pkt);
+            return 4;
+        }
+        g_memcpy(cdata + total, fe->pkt->data, fe->pkt->size);
+        total += fe->pkt->size;
+        av_packet_unref(fe->pkt);
+    }
+    if (err != AVERROR(EAGAIN) && err != AVERROR_EOF)
+    {
+        ffmpeg_log_error("avcodec_receive_packet", err);
+        return 3;
+    }
+    if (total == 0)
+    {
+        /* the encoder buffered the frame: low-latency options are not effective */
+        LOG(LOG_LEVEL_WARNING, "xrdp_encoder_ffmpeg: no output for this frame");
+        return 3;
+    }
+    *cdata_bytes = total;
+    return 0;
+}
+
+/*****************************************************************************/
+int
+xrdp_encoder_ffmpeg_encode(void *handle, int session, int left, int top,
+                           int width, int height, int twidth, int theight,
+                           int format, const char *data,
+                           short *crects, int num_crects,
+                           char *cdata, int *cdata_bytes, int connection_type,
+                           int *flags_ptr)
+{
+    struct ffmpeg_global *fg = (struct ffmpeg_global *)handle;
+    struct ffmpeg_encoder *fe;
+    AVFrame *in;
+    AVFrame *hw = NULL;
+    int flags = 0;
+    int ct;
+    int index;
+    int err;
+    int rv;
+
+    fe = &(fg->encoders[session % FFMPEG_MAX_ENCODERS]);
+    ct = connection_type;
+    if (ct > CONNECTION_TYPE_LAN || ct < CONNECTION_TYPE_MODEM)
+    {
+        ct = CONNECTION_TYPE_LAN;
+    }
+
+    if (fe->ctx == NULL || fe->width != width || fe->height != height)
+    {
+        if (fe->ctx != NULL)
+        {
+            ffmpeg_encoder_close(fe);
+            flags |= 2;
+        }
+        if (width > 0 && height > 0)
+        {
+            if ((rv = ffmpeg_encoder_open(fg, fe, width, height, ct)) != 0)
+            {
+                ffmpeg_encoder_close(fe);
+                return rv;
+            }
+            flags |= 1;
+        }
+        fe->width = width;
+        fe->height = height;
+    }
+
+    if (data != NULL && fe->ctx != NULL)
+    {
+        /* The encoder may still reference the previous frame's buffers. */
+        if ((err = av_frame_make_writable(fe->sw)) < 0)
+        {
+            ffmpeg_log_error("av_frame_make_writable", err);
+            return 2;
+        }
+        for (index = 0; index < num_crects; index++)
+        {
+            int x = crects[index * 4 + 0];
+            int y = crects[index * 4 + 1];
+            int cx = crects[index * 4 + 2];
+            int cy = crects[index * 4 + 3];
+            const char *src;
+            unsigned char *dst;
+            int row;
+
+            /* Y plane */
+            src = data + twidth * y + x;
+            dst = fe->sw->data[0] + fe->sw->linesize[0] * (y - top) + (x - left);
+            for (row = 0; row < cy; row++)
+            {
+                g_memcpy(dst, src, cx);
+                src += twidth;
+                dst += fe->sw->linesize[0];
+            }
+            /* interleaved UV plane, half height */
+            src = data + twidth * theight + twidth * (y / 2) + x;
+            dst = fe->sw->data[1] + fe->sw->linesize[1] * ((y - top) / 2) + (x - left);
+            for (row = 0; row < cy; row += 2)
+            {
+                g_memcpy(dst, src, cx);
+                src += twidth;
+                dst += fe->sw->linesize[1];
+            }
+        }
+
+        in = fe->sw;
+        if (fg->is_vaapi)
+        {
+            hw = av_frame_alloc();
+            if (hw == NULL || (err = av_hwframe_get_buffer(fe->hw_frames, hw, 0)) < 0 ||
+                    (err = av_hwframe_transfer_data(hw, fe->sw, 0)) < 0)
+            {
+                ffmpeg_log_error("upload to GPU", hw == NULL ? AVERROR(ENOMEM) : err);
+                av_frame_free(&hw);
+                return 2;
+            }
+            in = hw;
+        }
+        in->pts = fe->pts++;
+        /* An IDR (with SPS/PPS) after a new encoder or after lost output: there is
+         * no picture-loss feedback in MS-RDPEGFX, so a dropped frame would otherwise
+         * leave the client decoding against a missing reference until the next GOP. */
+        in->pict_type = ((flags & 1) || fe->force_idr) ?
+                        AV_PICTURE_TYPE_I : AV_PICTURE_TYPE_NONE;
+        err = avcodec_send_frame(fe->ctx, in);
+        av_frame_free(&hw);
+        if (err < 0)
+        {
+            ffmpeg_log_error("avcodec_send_frame", err);
+            fe->force_idr = 1;
+            return 3;
+        }
+        if ((rv = ffmpeg_drain(fe, cdata, cdata_bytes)) != 0)
+        {
+            fe->force_idr = 1;
+            return rv;
+        }
+        fe->force_idr = 0;
+    }
+    if (flags_ptr != NULL)
+    {
+        *flags_ptr = flags;
+    }
+    return 0;
+}
