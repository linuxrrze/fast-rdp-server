+/* [ffmpeg]: encoder, device, options (shared by all connection types) */
+static int
+tconfig_load_gfx_ffmpeg_global(toml_table_t *tfile,
+                               struct xrdp_tconfig_gfx_ffmpeg_global *g)
+{
+    toml_table_t *ff = toml_table_in(tfile, "ffmpeg");
+    toml_datum_t datum;
+
+    g_strncpy(g->encoder, "h264_vaapi", sizeof(g->encoder) - 1);
+    g_strncpy(g->device, "/dev/dri/renderD128", sizeof(g->device) - 1);
+    g->options[0] = '\0';
+    g_strncpy(g->fallback, "libx264", sizeof(g->fallback) - 1);
+    if (ff == NULL)
+    {
+        TCLOG(LOG_LEVEL_WARNING, "[ffmpeg] not defined, using h264_vaapi on %s",
+              g->device);
+        return 1;
+    }
+    datum = toml_string_in(ff, "encoder");
+    if (datum.ok)
+    {
+        g_strncpy(g->encoder, datum.u.s, sizeof(g->encoder) - 1);
+        free(datum.u.s);
+    }
+    datum = toml_string_in(ff, "device");
+    if (datum.ok)
+    {
+        g_strncpy(g->device, datum.u.s, sizeof(g->device) - 1);
+        free(datum.u.s);
+    }
+    datum = toml_string_in(ff, "options");
+    if (datum.ok)
+    {
+        g_strncpy(g->options, datum.u.s, sizeof(g->options) - 1);
+        free(datum.u.s);
+    }
+    datum = toml_string_in(ff, "fallback");
+    if (datum.ok)
+    {
+        g_strncpy(g->fallback, datum.u.s, sizeof(g->fallback) - 1);
+        free(datum.u.s);
+    }
+    return 0;
+}
+
+/* [ffmpeg.<connection type>]: rate control per connection type */
+static int
+tconfig_load_gfx_ffmpeg_ct(toml_table_t *tfile, const int connection_type,
+                           struct xrdp_tconfig_gfx_ffmpeg_param *param)
+{
+    struct xrdp_tconfig_gfx_ffmpeg_param *p = &param[connection_type];
+    toml_table_t *ff;
+    toml_table_t *ct;
+    toml_datum_t datum;
+
+    if (connection_type < 0 || connection_type >= NUM_CONNECTION_TYPES)
+    {
+        return 1;
+    }
+    if (connection_type == 0)
+    {
+        /* built-in defaults: constant quality, 60 fps, IDR every 5 s */
+        p->bitrate = 0;
+        p->max_bitrate = 0;
+        p->qp = 0;
+        p->gop = 300;
+        p->fps_num = 60;
+        p->fps_den = 1;
+        p->options[0] = '\0';
+    }
+    if ((ff = toml_table_in(tfile, "ffmpeg")) == NULL ||
+            (ct = toml_table_in(ff, rdpbcgr_connection_type_names[connection_type])) == NULL)
+    {
+        return connection_type == 0 ? 0 : 1;
+    }
+#define FF_INT(key, field) \
+    datum = toml_int_in(ct, key); \
+    if (datum.ok) { p->field = (int)datum.u.i; }
+    FF_INT("bitrate", bitrate);
+    FF_INT("max_bitrate", max_bitrate);
+    FF_INT("qp", qp);
+    FF_INT("gop", gop);
+    FF_INT("fps_num", fps_num);
+    FF_INT("fps_den", fps_den);
+#undef FF_INT
+    datum = toml_string_in(ct, "options");
+    if (datum.ok)
+    {
+        g_strncpy(p->options, datum.u.s, sizeof(p->options) - 1);
+        free(datum.u.s);
+    }
+    if (p->fps_num <= 0 || p->fps_den <= 0 || p->gop <= 0)
+    {
+        TCLOG(LOG_LEVEL_WARNING, "[ffmpeg.%s] invalid fps/gop, using 60/1 and 300",
+              rdpbcgr_connection_type_names[connection_type]);
+        p->fps_num = 60;
+        p->fps_den = 1;
+        p->gop = 300;
+    }
+    return 0;
+}
