# Started by fastrdp-termsrv-keytab.path. Settings: /etc/fastrdp/termsrv.conf.
[Unit]
Description=Copy TERMSRV keys for freerdp-proxy
Documentation=man:fastrdp-termsrv-keytab(8)

[Service]
Type=oneshot
ExecStart=/usr/sbin/fastrdp-termsrv-keytab
ExecStartPost=-/usr/bin/systemctl try-restart fastrdp-proxy.service
