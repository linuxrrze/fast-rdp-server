# /etc/fastrdp/broker.toml  (rendered by ansible role "broker")

[broker]
socket = "/run/fastrdp/broker.sock"        # proxy module + fastrdpctl
token_socket = "/run/fastrdp/token.sock"   # pam_fastrdp_token (root only)
proxy_user = "_fastrdp-proxy"
socket_group = "_fastrdp-broker"            # proxy + webgate; not the proxy's own group
state_dir = "/var/lib/fastrdp"
runtime_dir = "/run/fastrdp"
port_range = [33900, 34899]                # loopback ports for per-user Wayland back-ends
token_ttl = 60
session_start_timeout = 90
# Max. seconds to read ~/.config/fastrdp/desktop as root (NFS homes may hang or refuse
# root, e.g. sec=krb5); then the group/global default is used. 0 = never read homes.
#home_read_timeout = 3
# Kerberos TGT for GNOME/Plasma sessions (xrdp gets one through its own PAM stack):
# auto = when the login carries the password (NLA with delegated password, TLS),
# failure only logged; required = also refuse logins without a password (SSO without
# delegation, smartcard, web) and failed TGT requests; off. docs/nfs-kerberos-homes.md
#session_tgt = "auto"
# The user's home directory before any session starts: create = refuse logins whose
# home is unusable (missing parent such as an automount root that is not set up, not
# a directory, someone else's and not writable), and create a missing home like
# pam_mkhomedir (mode 0700, /etc/skel) when only its last component is missing below
# a root-owned parent; check = never create; off. Time limit: home_read_timeout.
#home_check = "create"
# home_check = "create" creates a home only when its parent directory is one of these
# or below one (also with symlinks resolved); never a root or another missing parent.
# [] = never create.
#home_create_roots = ["/home"]
# session_tgt per group (group = mode), e.g. required only for users with Kerberized
# NFS homes: members of listed groups get the strictest mode of their groups
# (required > auto > off) instead of session_tgt; group names as in allow_groups.
#[broker.session_tgt_groups]
#"nfs-homes" = "required"
#"kiosk" = "off"
# Desktop picker in the RDP window after the second factor (proxy.ini [FastRDP]
# WaitingScreen = true and fastrdp-freerdp3 >= 3.32.2-6): never; if_multiple = users who
# may use more than one desktop and have chosen none yet (web gateway, fastrdpctl
# desktop, ~/.config/fastrdp/desktop); always = also then, their choice preselected.
# Never for logins that name a desktop (AlternateShell "fastrdp:<name>", the web gateway,
# downloaded .rdp files). docs/desktop-matrix.md#choosing-a-desktop
#desktop_picker = "never"
#desktop_picker_timeout = 10                 # seconds, 3..60; then the preselected desktop
#desktop_picker_when_running = "preselect"   # a running session: preselect it, or "skip"
                                             # the picker and reconnect to it

[auth]
realms = ["EXAMPLE.COM"]          # Kerberos realms accepted from NLA
# true: SSSD has short names (use_fully_qualified_names = false), alice@EXAMPLE.COM ->
# "alice" before "alice@example.com"; false: SSSD has fully qualified names, the
# other way round, so a local account "alice" never shadows the directory user.
# TLS and web logins ("alice", "DOMAIN\alice", "alice@example.com") follow the same order.
strip_realm = true
# SSSD domain names of qualified accounts besides the realms (FreeIPA domain that
# differs from its realm); group names in this file match "group@<domain>" too.
#domains = ["example.com"]
pam_service = "fastrdp"           # password checks (TLS logins) + account checks
allow_groups = ["rdp-users"]      # empty list = every valid account
allow_tls_password_login = true   # clients without NLA (password+OTP in one field)

[mfa]
mode = "otp_or_push"              # none | otp | push | otp_or_push | web | push_or_web | code_or_web
exempt_groups = []
otp_lengths = [6]                 # keep one TOTP length; see docs/auth-matrix.md
yubikey_otp = true
# true: Kerberos NLA logins from [auth] realms skip privacyIDEA because the KDC only
# issues TERMSRV tickets after passkey/PKINIT pre-authentication (FreeIPA auth
# indicators; docs/passkeys.md). TLS and web logins are unaffected. Not for AD.
#nla_kdc_enforced = false
# Per login instead: Kerberos NLA logins from [auth] realms whose ticket carries one of
# these skip privacyIDEA; the KDC put them there (verified by the proxy's FreeRDP).
# "ind:<authentication indicator>" (FreeIPA/MIT: ind:pkinit, ind:passkey) or
# "sid:<group SID>" from the PAC (AD: sid:S-1-18-4 Windows Hello for Business key trust,
# sid:S-1-18-3 PKINIT with freshness, an Authentication Mechanism Assurance group).
# Not ind:hardened, sid:S-1-18-1/-2 (password logons have them too). docs/passkeys.md
#kdc_evidence_as_mfa = []
# Reconnects after a network drop (no RDP auto-reconnect cookies) skip a second factor
# passed less than this many seconds ago by the same account, login method (nla/tls),
# Kerberos principal and, with reconnect_grace_same_address, client address. Counted
# from that OTP/push, never extended; memory only; 0 = off, max 3600, 300-900 suggested.
# `fastrdpctl clear-grace USER` revokes it. docs/auth-matrix.md#reconnect-grace
#reconnect_grace = 0
#reconnect_grace_same_address = true
# mode "web": a login waits until its user approves it on https://<host>/web/approve
# after a fresh MFA sign-in at the IdP; "push_or_web": a push at the same time, the
# first answer wins. Both need [web] enabled. docs/auth-matrix.md#web-approval
#web_approval_timeout = 90          # seconds; plus session_start_timeout at most proxy.ini
                                    # [FastRDP] Timeout (180)
#web_approval_max_auth_age = 30     # the sign-in may be this much older than the login
#web_approval_single_pending = true # 2+ pending logins of a user: none can be approved
# mode "code_or_web": the user types the authenticator code on the proxy's waiting screen
# (checked by Keycloak, [mfa.keycloak]) or approves the login on the approval page
# (passkey); the first success wins. docs/auth-matrix.md#code-on-the-waiting-screen
#code_attempts = 3                  # wrong codes per login, then it fails
#code_user_failures = 10            # wrong codes per user within code_failure_window:
#code_failure_window = 900          # the code field stays closed (approval page only)

[mfa.privacyidea]
url = "https://privacyidea.example.com"
realm = "example"
ca_file = "/etc/fastrdp/privacyidea-ca.pem"
timeout = 10
push_timeout = 60
service_user = "fastrdp-trigger"  # admin with triggerchallenge policy; "" = use user password
service_password_file = "/etc/fastrdp/privacyidea-service.secret"

# mode "code_or_web": a confidential Keycloak client with direct grants only, whose
# direct grant flow has Username Validation + OTP (no password); the broker checks the
# code with it and ends the Keycloak session at once (docs/examples/keycloak-mfa).
#[mfa.keycloak]
#issuer = "https://keycloak.example.com/realms/example"
#client_id = "fastrdp-otp-check"
#client_secret_file = "/etc/fastrdp/keycloak-otp.secret"
#ca_file = ""                      # "" = system trust store
#timeout = 10
#required_amr = "otp"              # a token counts only with this in amr (the OTP step's reference)

# Connection type the proxy sends to xrdp, which selects gfx.toml's encoder profile
# ([x264.<type>], [ffmpeg.<type>]). Only for clients that did not choose one themselves
# (mstsc's default is auto-detect; the proxy does not measure the network).
[network]
lan_networks = []                 # client CIDRs that get `lan`, e.g. ["10.0.0.0/8", "2001:db8::/32"]
xrdp_autodetect_profile = "wan"   # everyone else: modem broadband_low satellite broadband_high wan lan default

# Texts of the proxy's waiting screen (proxy.ini [FastRDP] WaitingScreen): shown while a
# login waits for its push or web approval and while the session starts.
# docs/auth-matrix.md#waiting-screen
[ui]
language = "en"                  # built in: en, de; others need an [ui.<language>] table
language_from_keyboard = true    # the client's keyboard layout picks a language that has texts
# The webgate's approval page as users reach it ("" = not named; no QR code), e.g.
# "https://rdp1.example.com/web/approve"; at most 184 characters (the QR code adds ?login=<id>)
approve_url = ""
qr_code = true                   # QR code of approve_url?login=<id>, to approve this login on a phone
# Own texts per language, each optional; placeholders {user} {approve_url} {timeout}
# {method} {desktop} {code} (the web approval's two-digit code); a line naming
# {approve_url} is left out while approve_url is "", one naming {code} without a code.
#[ui.de]
#mfa_push = "Anmeldung bestätigen\nBitte bestätigen Sie die Push-Benachrichtigung auf Ihrem Telefon."
#mfa_web = "..."
#mfa_push_or_web = "..."
#mfa_code_or_web = "..."
#qr_hint = "..."
#session_start = "Verbindung zu Ihrem Desktop ({desktop}) wird hergestellt…"
#countdown = "Verbleibend:"
# Desktop picker ([broker] desktop_picker); also {running} and {count}:
#picker_title = "Desktop auswählen"
#picker_hint = "1-{count}, Pfeiltasten + Eingabe oder Klick. Esc: {desktop}"
#picker_countdown = "Weiter in"
#picker_running = "{desktop} (läuft)"
#picker_reconnects = "{desktop} (öffnet das laufende {running})"
# Code field (mode code_or_web); code_wrong also {count} (attempts left):
#code_label = "Authenticator-Code:"
#code_checking = "Code wird geprüft…"
#code_wrong = "Falscher Code. Verbleibende Versuche: {count}"
#code_unavailable = "..."
#code_blocked = "..."

[defaults]
desktop = "xfce"
geometry = "1920x1080"

[defaults.groups]                 # AD group -> default desktop
"rdp-gnome" = "gnome"
"rdp-kde" = "plasma"

[desktops.xfce]
backend = "xrdp"
xsession = "xfce"
label = "Xfce"

[desktops.mate]
backend = "xrdp"
xsession = "mate"

[desktops.cinnamon]
backend = "xrdp"
xsession = "cinnamon"

[desktops.lxqt]
backend = "xrdp"
xsession = "lxqt"

[desktops.plasma-x11]
backend = "xrdp"
xsession = "plasmax11"

[desktops.gnome]
backend = "gnome"

[desktops.plasma]
backend = "plasma"

[backends.xrdp]
host = "127.0.0.1"
port = 3390
listener_user = "root"   # xrdp binds as root, then drops privileges
# xrdp.ini "certificate": the proxy accepts only this certificate from xrdp
certificate = "/etc/xrdp/cert.pem"

[backends.gnome]
unit = "gnome-headless-session@{user}.service"

[backends.plasma]
unit = "fastrdp-plasma@{user}.service"
