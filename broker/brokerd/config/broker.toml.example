# /etc/fastrdp/broker.toml  (rendered by ansible role "broker")

[broker]
socket = "/run/fastrdp/broker.sock"        # proxy module + fastrdpctl
token_socket = "/run/fastrdp/token.sock"   # pam_fastrdp_token (root only)
proxy_user = "_fastrdp-proxy"
socket_group = "_fastrdp-broker"            # proxy + webgate; not the proxy's own group
state_dir = "/var/lib/fastrdp"
runtime_dir = "/run/fastrdp"
port_range = [33900, 34899]                # loopback ports for per-user Wayland back-ends
token_ttl = 60
session_start_timeout = 90
# Max. seconds to read ~/.config/fastrdp/desktop as root (NFS homes may hang or refuse
# root, e.g. sec=krb5); then the group/global default is used. 0 = never read homes.
#home_read_timeout = 3
# Kerberos TGT for GNOME/Plasma sessions (xrdp gets one through its own PAM stack):
# auto = when the login carries the password (NLA with delegated password, TLS),
# failure only logged; required = also refuse logins without a password (SSO without
# delegation, smartcard, web) and failed TGT requests; off. docs/nfs-kerberos-homes.md
#session_tgt = "auto"

[auth]
realms = ["EXAMPLE.COM"]          # Kerberos realms accepted from NLA
strip_realm = true                # alice@EXAMPLE.COM -> local account "alice"
pam_service = "fastrdp"           # password checks (TLS logins) + account checks
allow_groups = ["rdp-users"]      # empty list = every valid account
allow_tls_password_login = true   # clients without NLA (password+OTP in one field)

[mfa]
mode = "otp_or_push"              # none | otp | push | otp_or_push
exempt_groups = []
otp_lengths = [6]                 # keep one TOTP length; see docs/auth-matrix.md
yubikey_otp = true
# true: Kerberos NLA logins from [auth] realms skip privacyIDEA because the KDC only
# issues TERMSRV tickets after passkey/PKINIT pre-authentication (FreeIPA auth
# indicators; docs/passkeys.md). TLS and web logins are unaffected. Not for AD.
#nla_kdc_enforced = false

[mfa.privacyidea]
url = "https://privacyidea.example.com"
realm = "example"
ca_file = "/etc/fastrdp/privacyidea-ca.pem"
timeout = 10
push_timeout = 60
service_user = "fastrdp-trigger"  # admin with triggerchallenge policy; "" = use user password
service_password_file = "/etc/fastrdp/privacyidea-service.secret"

# Connection type the proxy sends to xrdp, which selects gfx.toml's encoder profile
# ([x264.<type>], [ffmpeg.<type>]). Only for clients that did not choose one themselves
# (mstsc's default is auto-detect; the proxy does not measure the network).
[network]
lan_networks = []                 # client CIDRs that get `lan`, e.g. ["10.0.0.0/8", "2001:db8::/32"]
xrdp_autodetect_profile = "wan"   # everyone else: modem broadband_low satellite broadband_high wan lan default

[defaults]
desktop = "xfce"
geometry = "1920x1080"

[defaults.groups]                 # AD group -> default desktop
"rdp-gnome" = "gnome"
"rdp-kde" = "plasma"

[desktops.xfce]
backend = "xrdp"
xsession = "xfce"
label = "Xfce"

[desktops.mate]
backend = "xrdp"
xsession = "mate"

[desktops.cinnamon]
backend = "xrdp"
xsession = "cinnamon"

[desktops.lxqt]
backend = "xrdp"
xsession = "lxqt"

[desktops.plasma-x11]
backend = "xrdp"
xsession = "plasmax11"

[desktops.gnome]
backend = "gnome"

[desktops.plasma]
backend = "plasma"

[backends.xrdp]
host = "127.0.0.1"
port = 3390
listener_user = "root"   # xrdp binds as root, then drops privileges

[backends.gnome]
unit = "gnome-headless-session@{user}.service"

[backends.plasma]
unit = "fastrdp-plasma@{user}.service"
