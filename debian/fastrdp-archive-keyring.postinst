#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Marcel Ritter <marcel@linux-ng.de>
set -e

#DEBHELPER#

URL=https://linuxrrze.github.io/fast-rdp-server
SOURCES=$DPKG_ROOT/etc/apt/sources.list.d/fast-rdp-server.sources

# The repository as an APT source, unless one is there already (the Ansible role's
# apt_repo.yml, or your own: any file naming the URL). Stable channel of this release.
if [ "$1" = configure ] && [ ! -e "$SOURCES" ] &&
    ! grep -qrsF "$URL" "$DPKG_ROOT/etc/apt/sources.list" "$DPKG_ROOT/etc/apt/sources.list.d"; then
    # shellcheck disable=SC1091 # the target's os-release
    codename=$(. "$DPKG_ROOT/etc/os-release" && echo "${VERSION_CODENAME:-}") 2>/dev/null || codename=
    case $codename in
        resolute|trixie)
            mkdir -p "$(dirname "$SOURCES")"
            cat > "$SOURCES" <<EOT
# fastrdp-archive-keyring: written at installation, removed on purge.
# Suites: $codename-testing follows the main branch.
Types: deb
URIs: $URL
Suites: $codename-stable
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/fast-rdp-server-archive-keyring.asc
EOT
            chmod 0644 "$SOURCES"
            echo "fastrdp-archive-keyring: added $SOURCES ($codename-stable); run apt update"
            ;;
        *)
            echo "fastrdp-archive-keyring: no packages for '${codename:-unknown}' (Ubuntu 26.04 resolute, Debian 13 trixie); no APT source added" >&2
            ;;
    esac
fi
