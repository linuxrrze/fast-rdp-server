# fastrdp-brokerd: the session broker daemon. fastrdp-brokerd.service runs the same
# code with "python3 -m fastrdp_broker"; this wrapper is for manual runs and --check.
PYTHONPATH=/usr/lib/fastrdp/python exec /usr/bin/python3 -c 'import sys; from fastrdp_broker.__main__ import daemon_main; sys.exit(daemon_main())' "$@"
