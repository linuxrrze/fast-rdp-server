"""fastrdp-setup: guided creation of an Ansible inventory for fast-rdp-server.

Runs on the admin machine (Python 3 standard library only). Asks the questions a
deployment needs, writes

    ansible/inventories/<name>/hosts.yml
    ansible/inventories/<name>/group_vars/all/main.yml   (only what the roles need or what differs)
    ansible/inventories/<name>/group_vars/all/vault.yml  (secrets, encrypted with ansible-vault)
    ansible/inventories/<name>/setup-answers.json        (the answers without secrets, for re-runs)

and prints the next commands (preflight, playbook, smoke test, first connection).
Interactive runs remember the non-secret answers after every question in
ansible/inventories/.setup-last-answers.json (also when cancelled) and offer them as
defaults next time; --fresh ignores them.

    scripts/fastrdp-setup                               # interactive
    scripts/fastrdp-setup --answers site.json --non-interactive \\
        --vault-password-file ~/.fastrdp-vault          # scripted (secrets from FASTRDP_* env vars)

See docs/quickstart.md.
"""

import argparse
import getpass
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

