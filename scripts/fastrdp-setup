QUESTION_KEYS = {q.key for q in QUESTIONS}
# Answers without a question (answers file / --set only).
EXTRA_KEYS = {"connection", "privacyidea_verify_tls", "vault_password_file"}


# ----------------------------------------------------------------------------- answering

_ROLE_DEFAULT = object()


def ask_interactive(q, a, stream_in=sys.stdin, stream_out=sys.stderr, default=_ROLE_DEFAULT):
    """Ask until the answer validates. default: shown and taken on Enter (else the question's)."""
    if default is _ROLE_DEFAULT:
        default = q.default_for(a)
    if q.help:
        print("\n" + q.help, file=stream_out)
    while True:
        if q.secret:
            raw = getpass.getpass(q.prompt + ": ")
            if raw:
                again = getpass.getpass("  repeat: ")
                if again != raw:
                    print("  do not match, again", file=stream_out)
                    continue
        else:
            shown = ""
            if default is not None:
                shown = default
                if isinstance(default, list):
                    shown = ",".join(default)
                elif isinstance(default, bool):
                    shown = "y" if default else "n"
                shown = f" [{shown}]" if shown != "" else " [none]"
            print(f"{q.prompt}{shown}: ", end="", file=stream_out, flush=True)
            raw = stream_in.readline()
            if not raw:
                raise SetupError("input ended")
            raw = raw.rstrip("\n")
            if raw.strip() == "" and default is not None:
                raw = default
        try:
            return q.validate(raw, a)
        except SetupError as e:
            print(f"  -> {e}", file=stream_out)


LAST_ANSWERS = ".setup-last-answers.json"
REMEMBERED_KEYS = {q.key for q in QUESTIONS if not q.secret} - set(VAULT_KEYS)


class LastAnswers:
    """Non-secret answers of the last interactive run, in <output-dir>/.setup-last-answers.json.

    Saved after every answer, so a cancelled run keeps what was entered; offered as the
    defaults of the next interactive run. Answers not reached in this run are kept."""

    def __init__(self, path, fresh=False):
        self.path = Path(path)
        self.values = {} if fresh else self._load()
        self.failed = False

    def _load(self):
        try:
            data = json.loads(self.path.read_text())
        except FileNotFoundError:
            return {}
        except (OSError, ValueError) as e:
            print(f"ignoring {self.path}: {e}", file=sys.stderr)
            return {}
        if not isinstance(data, dict):
            return {}
        return {k: v for k, v in data.items() if k in REMEMBERED_KEYS}

    def default_for(self, q, a):
        """The remembered answer if it still validates here, else the question's default."""
        if q.key in self.values:
            try:
                return q.validate(self.values[q.key], a)
            except (SetupError, TypeError, KeyError, AttributeError, IndexError, ValueError):
                pass
        return q.default_for(a)

    def save(self, a):
        if self.failed:
            return
        self.values.update({k: v for k, v in a.items() if k in REMEMBERED_KEYS and v is not None})
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=self.path.parent, prefix=self.path.name + ".")
            with os.fdopen(fd, "w") as f:       # mkstemp: mode 0600
                json.dump(self.values, f, indent=2)
                f.write("\n")
            os.replace(tmp, self.path)
        except OSError as e:
            self.failed = True
            print(f"  (answers not remembered: {e})", file=sys.stderr)


def resolve(given, interactive, env=os.environ, last=None, stream_in=None, stream_out=None):
    """Fill and validate all answers. given: dict from answers file / --set.
    last: LastAnswers (interactive runs) for remembered defaults, saved after every answer."""
    asks = {"stream_in": stream_in or sys.stdin, "stream_out": stream_out or sys.stderr}
    unknown = set(given) - QUESTION_KEYS - EXTRA_KEYS
    if unknown:
        raise SetupError("unknown answer key(s): " + ", ".join(sorted(unknown)))
    a = {k: given[k] for k in EXTRA_KEYS if k in given}
    if "privacyidea_verify_tls" in a:
        a["privacyidea_verify_tls"] = _bool(a["privacyidea_verify_tls"])
    if interactive and "install_method" not in given:
        print("Checking the fastrdp APT repository ...", file=sys.stderr)
        a["_apt_probe"] = probe_apt_repo()
        if not a["_apt_probe"]:
            print("  not published yet (or not reachable): defaulting to build.\n"
                  "  Once it is published, apt is the recommended install method.", file=sys.stderr)
    errors = []
    for q in QUESTIONS:
        try:
            if not q.when(a):
                continue
            if q.key in given:
                try:
                    a[q.key] = q.validate(given[q.key], a)
                except SetupError as e:
                    if not interactive:
                        raise
                    print(f"{q.key}: {e}", file=sys.stderr)
                    a[q.key] = ask_interactive(q, a, **asks)
            elif q.secret and env.get(SECRET_ENV.get(q.key, "")):
                a[q.key] = v_secret(env[SECRET_ENV[q.key]], a)
            elif interactive and q.ask(a):
                if last is not None:
                    a[q.key] = ask_interactive(q, a, default=last.default_for(q, a), **asks)
                else:
                    a[q.key] = ask_interactive(q, a, **asks)
            else:
                default = q.default_for(a)
                if default is None:
                    hint = f" (or environment variable {SECRET_ENV[q.key]})" if q.key in SECRET_ENV else ""
                    raise SetupError(f"missing answer{hint}")
                a[q.key] = q.validate(default, a)
            if last is not None:
                last.save(a)
        except SetupError as e:
            errors.append(f"{q.key}: {e}")
            a[q.key] = None
        except (TypeError, KeyError, AttributeError, IndexError):
            # depends on an earlier answer that is missing or invalid
            if not errors:
                raise
            a[q.key] = None
    if errors:
        raise SetupError("invalid answers:\n  " + "\n  ".join(errors))
    a.pop("_apt_probe", None)
    return a


# ----------------------------------------------------------------------------- generation

def variables_for(a):
    """All role variables for these answers (name -> value), before default filtering."""
    v = {
        "fastrdp_realm": a["realm"],
        "fastrdp_domain": a["domain"],
        "fastrdp_identity_provider": a["identity_provider"],
        "fastrdp_allow_groups": a["allow_groups"],
        "fastrdp_sssd_fully_qualified_names": bool(a.get("sssd_fully_qualified_names", False)),
        "fastrdp_listen_port": 3389,
        "fastrdp_front_cert_src": a.get("tls_cert", "") if a["tls"] == "provided" else "",
        "fastrdp_front_key_src": a.get("tls_key", "") if a["tls"] == "provided" else "",
        "fastrdp_allow_tls_logins": a["allow_tls_logins"],
        "fastrdp_mfa_mode": a["mfa_mode"],
        "fastrdp_privacyidea_realm": a.get("privacyidea_realm", ""),
        "fastrdp_privacyidea_ca_src": a.get("privacyidea_ca", ""),
        "fastrdp_privacyidea_service_user": a.get("privacyidea_service_user", ""),
        "fastrdp_mfa_exempt_groups": a.get("mfa_exempt_groups", []),
        "fastrdp_otp_lengths": [6],
        "fastrdp_mfa_kdc_evidence_as_mfa": a.get("mfa_kdc_evidence_as_mfa", []),
        "fastrdp_desktops": a["desktops"],
        "fastrdp_default_desktop": a["default_desktop"],
        "fastrdp_group_desktops": {},
        "fastrdp_default_geometry": "1920x1080",
        "fastrdp_audio": _audio(a),
        "fastrdp_audio_input": bool(a.get("audio_input", True)),
        "fastrdp_gpu": a["gpu"],
        "fastrdp_x264_threads": 2,
        "fastrdp_backend_port_range": [33900, 34899],
        "fastrdp_xrdp_port": 3390,
        "fastrdp_lan_networks": a.get("lan_networks", []),
        "fastrdp_proc_hidepid": False,
        "fastrdp_install_method": a["install_method"],
        "fastrdp_web_enabled": a["web_enabled"],
    }
    if _join(a):
        v["fastrdp_join_user"] = a["join_user"]
        v["fastrdp_join_password"] = "{{ vault_fastrdp_join_password | default('') }}"
    if a["identity_provider"] == "ad":
        v["fastrdp_ad_gpo_access_control"] = a.get("ad_gpo_access_control", "permissive")
    if a["identity_provider"] == "none":
        v["fastrdp_termsrv_keytab_src"] = a.get("termsrv_keytab", "")
    if _pi(a):
        v["fastrdp_privacyidea_url"] = a["privacyidea_url"]
        if "privacyidea_verify_tls" in a:
            v["fastrdp_privacyidea_verify_tls"] = a["privacyidea_verify_tls"]
        if a.get("privacyidea_service_user"):
            v["fastrdp_privacyidea_service_password"] = \
                "{{ vault_fastrdp_privacyidea_service_password | default('') }}"
    if _web_approval(a):
        timeout = a.get("mfa_web_approval_timeout", 90)
        v["fastrdp_mfa_web_approval_timeout"] = timeout
        v["fastrdp_mfa_web_approval_max_auth_age"] = a.get("mfa_web_approval_max_auth_age", 30)
        v["fastrdp_mfa_web_approval_single_pending"] = bool(a.get("mfa_web_approval_single_pending", True))
        # the proxy's wait covers the approval and the session start after it
        v["fastrdp_proxy_broker_timeout"] = max(ROLE_DEFAULTS["fastrdp_proxy_broker_timeout"],
                                                timeout + SESSION_START_TIMEOUT)
    if a["install_method"] == "apt":
        v["fastrdp_apt_channel"] = a["apt_channel"]
        v["fastrdp_apt_key_checksum"] = a.get("apt_key_checksum", "")
    if _web(a):
        v["fastrdp_web_oidc_issuer"] = a["web_oidc_issuer"]
        v["fastrdp_web_oidc_client_id"] = a["web_oidc_client_id"]
        v["fastrdp_web_oidc_ca_src"] = a.get("web_oidc_ca", "")
        v["fastrdp_web_public_url"] = a.get("web_public_url", ROLE_DEFAULTS["fastrdp_web_public_url"])
    return v


def secrets_for(a):
    return {VAULT_KEYS[k]: a[k] for k in VAULT_KEYS if a.get(k)}


_PLAIN_RE = re.compile(r"^[A-Za-z_./][A-Za-z0-9_./@-]*$")
_YAML_WORDS = {"y", "n", "yes", "no", "true", "false", "on", "off", "null", "~"}


def yaml_scalar(value):
    """YAML for a scalar/list/dict of scalars: plain when unambiguous, else JSON (valid YAML)."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(yaml_scalar(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{" + ", ".join(f"{yaml_scalar(k)}: {yaml_scalar(v)}" for k, v in value.items()) + "}"
    s = str(value)
    if _PLAIN_RE.match(s) and s.lower() not in _YAML_WORDS and not s.endswith(":"):
        return s
    return json.dumps(s, ensure_ascii=False)


def render_main(a):
    values = variables_for(a)
    out = ["---",
           "# Generated by scripts/fastrdp-setup. Only two kinds of variables are here:",
           "#   (required)     no usable default (roles/common checks it), so every inventory sets it;",
           "#   (default: X)   differs from the role default X (ansible/roles/*/defaults/main.yml).",
           "# Regenerate with: scripts/fastrdp-setup --answers <this dir>/setup-answers.json --force",
           "# Paths (*_src) are on the admin machine."]
    section = None
    for sec, name, default, comment in VARIABLES:
        if name not in values:
            continue
        value = values[name]
        if default is not REQUIRED and value == default:
            continue
        if sec != section:
            out.append("")
            out.append(f"# {'-' * (70 - len(sec))} {sec}")
            if sec == "MFA" and not _mfa(a):
                out.append("# MFA is off; the broker configuration still reads these privacyIDEA settings.")
            section = sec
        note = "required" if default is REQUIRED else f"default: {yaml_scalar(default)}"
        out.append(f"# {comment} ({note})")
        out.append(f"{name}: {yaml_scalar(value)}")
    return "\n".join(out) + "\n"


def render_hosts(a):
    out = ["---", "# Generated by scripts/fastrdp-setup.", "all:", "  children:", "    rdp_servers:",
           "      hosts:"]
    for h in a["hosts"]:
        out.append(f"        {yaml_scalar(h)}: {{}}")
    hv = {}
    if a.get("ssh_user"):
        hv["ansible_user"] = a["ssh_user"]
    if a.get("connection"):
        hv["ansible_connection"] = a["connection"]
    if a.get("become_exe", "sudo") != "sudo":
        hv["ansible_become_exe"] = a["become_exe"]       # sudo.ws: classic sudo next to sudo-rs
    if hv:
        out.append("      vars:")
        out.extend(f"        {k}: {yaml_scalar(v)}" for k, v in hv.items())
    return "\n".join(out) + "\n"


def render_vault(secrets):
    out = ["---"]
    out.extend(f"{k}: {json.dumps(v, ensure_ascii=False)}" for k, v in secrets.items())
    return "\n".join(out) + "\n"


def public_answers(a):
    return {k: v for k, v in a.items() if k not in VAULT_KEYS and k != "vault_password_file"}


def check_known_variables(main_text, roots=(ANSIBLE_DIR / "roles", ANSIBLE_DIR / "site.yml")):
    """Every fastrdp_* variable written must be used by the roles (grep). Returns unknown names."""
    corpus = []
    for root in roots:
        root = Path(root)
        if not root.exists():
            return None          # not running from a checkout: cannot check
        files = [root] if root.is_file() else [p for p in root.rglob("*") if p.is_file()]
        for f in files:
            try:
                corpus.append(f.read_text(errors="replace"))
            except OSError:
                pass
    text = "\n".join(corpus)
    names = re.findall(r"^(fastrdp_[a-z0-9_]+):", main_text, re.M)
    return [n for n in names if not re.search(r"\b" + n + r"\b", text)]


# ----------------------------------------------------------------------------- vault

def find_ansible_vault():
    return os.environ.get("FASTRDP_ANSIBLE_VAULT") or shutil.which("ansible-vault")


def write_vault(path, secrets, vault_bin, password_file=None, password=None, plaintext_ok=False):
    """Write vault.yml encrypted (plaintext goes to ansible-vault via stdin, never to disk).
    Returns 'encrypted' or 'plaintext'."""
    content = render_vault(secrets)
    if vault_bin:
        with tempfile.TemporaryDirectory(prefix="fastrdp-setup-") as tmp:
            pwfile = password_file
            if not pwfile:
                if not password:
                    raise SetupError("a vault password is needed (--vault-password-file or FASTRDP_VAULT_PASSWORD)")
                pwfile = os.path.join(tmp, "pw")
                fd = os.open(pwfile, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w") as f:
                    f.write(password + "\n")
            tmp_out = Path(path).with_name(".vault.yml.tmp")
            tmp_out.unlink(missing_ok=True)
            r = subprocess.run([vault_bin, "encrypt", "--vault-password-file", str(pwfile),
                                "--output", str(tmp_out), "-"],
                               input=content, text=True, capture_output=True, check=False)
            if r.returncode != 0 or not tmp_out.exists() or \
                    not tmp_out.read_text(errors="replace").startswith("$ANSIBLE_VAULT;"):
                tmp_out.unlink(missing_ok=True)
                raise SetupError("ansible-vault encrypt failed: " + (r.stderr or r.stdout).strip())
            os.chmod(tmp_out, 0o600)
            os.replace(tmp_out, path)
        return "encrypted"
    if not plaintext_ok:
        raise SetupError("ansible-vault not found: install ansible-core, or pass --plaintext-vault "
                         "to write vault.yml unencrypted (mode 0600) and encrypt it later")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.chmod(path, 0o600)
    return "plaintext"


# ----------------------------------------------------------------------------- main

def load_answers(path):
    text = Path(path).read_text()
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        try:
            import yaml   # optional: YAML answers files when PyYAML is installed
        except ImportError:
            raise SetupError(f"{path}: not JSON (YAML answers files need PyYAML)") from None
        data = yaml.safe_load(text)
    if not isinstance(data, dict):
        raise SetupError(f"{path}: expected a mapping of answers")
    return data


def parse_set(items):
    out = {}
    for item in items or []:
        if "=" not in item:
            raise SetupError(f"--set {item!r}: expected key=value")
        k, v = item.split("=", 1)
        out[k.strip()] = v
    return out


def next_steps(a, inv_dir, vault_mode, password_file):
    inv_dir = Path(inv_dir).resolve()
    rel = os.path.relpath(inv_dir, ANSIBLE_DIR) if REPO in inv_dir.parents else str(inv_dir)
    flags = []
    if vault_mode:
        flags.append(f"--vault-password-file {password_file}" if password_file else "--ask-vault-pass")
    if a.get("become_password"):
        flags.append("--ask-become-pass")
    f = (" " + " ".join(flags)) if flags else ""
    host = a["hosts"][0]
    make_inv = a["name"] if inv_dir.parent == (ANSIBLE_DIR / "inventories").resolve() else str(inv_dir)
    if password_file and vault_mode:
        make_inv += f" VAULT_PASSWORD_FILE={password_file}"
    if a.get("become_password"):
        make_inv += " ANSIBLE_ARGS=-K"      # make passes it on to ansible-playbook
    user = "alice"
    lines = [
        "",
        f"Inventory written to {inv_dir}",
        "",
        "Next steps (from the repository root):",
        f"  1. Review {inv_dir / 'group_vars/all/main.yml'} (comments say what each line does).",
        "  2. Preflight, read-only checks on the target(s):",
        f"       make preflight INVENTORY={make_inv}",
        f"     or: cd ansible && ansible-playbook -i {rel}/hosts.yml preflight.yml{f}",
        "  3. Deploy:",
        f"       make deploy INVENTORY={make_inv}",
        f"     or: cd ansible && ansible-playbook -i {rel}/hosts.yml site.yml{f}",
        "  4. Smoke test on the host(s) with a directory user:",
        f"       cd ansible && ansible -i {rel}/hosts.yml rdp_servers -b{f} \\",
        f"           -m ansible.builtin.script -a '../tests/smoke/check-host.sh {user}'",
        "  5. First connection (docs/client-guide.md):",
        f"       xfreerdp3 /v:{host} /u:{user} /d:{a['realm']} /sec:nla /gfx:avc444 /dynamic-resolution",
    ]
    if a["tls"] == "self-signed":
        lines.append("     (self-signed certificate: accept it once, or add /cert:tofu)")
    if a["install_method"] == "build":
        lines += ["", "Note: install method 'build' compiles FreeRDP and xrdp on the host (about 10-20 min",
                  "on the first run). Once the APT repository is published, re-run with install_method=apt."]
    if vault_mode == "plaintext":
        lines += ["", f"WARNING: {inv_dir}/group_vars/all/vault.yml is NOT encrypted. Run:",
                  f"  ansible-vault encrypt {inv_dir}/group_vars/all/vault.yml"]
    return "\n".join(lines)


def generate(a, out_root, force=False, password_file=None, vault_password=None, plaintext_ok=False,
             vault_bin=None):
    inv_dir = Path(out_root) / a["name"]
    if inv_dir.exists() and not force:
        raise SetupError(f"{inv_dir} exists; use --force to overwrite or choose another name")
    main_text = render_main(a)
    unknown = check_known_variables(main_text)
    if unknown:
        raise SetupError("internal error, variables not used by any role: " + ", ".join(unknown))
    secrets = secrets_for(a)
    if secrets and not vault_bin and not plaintext_ok:
        write_vault(None, secrets, None)          # raises the explanation
    created = not inv_dir.exists()
    gv = inv_dir / "group_vars" / "all"
    try:
        gv.mkdir(parents=True, exist_ok=True)
        vault_path = gv / "vault.yml"
        vault_mode = None
        if secrets:     # first: if encryption fails, nothing else is written
            vault_mode = write_vault(vault_path, secrets, vault_bin, password_file, vault_password, plaintext_ok)
        elif vault_path.exists():
            vault_path.unlink()
        (inv_dir / "hosts.yml").write_text(render_hosts(a))
        (gv / "main.yml").write_text(main_text)
        (inv_dir / "setup-answers.json").write_text(json.dumps(public_answers(a), indent=2) + "\n")
    except (SetupError, OSError):
        if created:
            shutil.rmtree(inv_dir, ignore_errors=True)
        raise
    return inv_dir, vault_mode


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="fastrdp-setup", description="Guided inventory creation for fast-rdp-server (docs/quickstart.md).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Secrets for --non-interactive: " + ", ".join(SECRET_ENV.values()) +
               ", FASTRDP_VAULT_PASSWORD.\nAnswer keys: " + " ".join(q.key for q in QUESTIONS) +
               " " + " ".join(sorted(EXTRA_KEYS)))
    p.add_argument("--answers", metavar="FILE", help="answers file (JSON; YAML with PyYAML)")
    p.add_argument("--set", action="append", metavar="KEY=VALUE", help="single answer (repeatable)")
    p.add_argument("--non-interactive", action="store_true", help="never prompt; fail on missing answers")
    p.add_argument("--output-dir", default=str(ANSIBLE_DIR / "inventories"),
                   help="where the inventory directory is created (default: ansible/inventories)")
    p.add_argument("--vault-password-file", help="encrypt vault.yml with this password file")
    p.add_argument("--plaintext-vault", action="store_true",
                   help="allow writing vault.yml unencrypted when ansible-vault is missing")
    p.add_argument("--force", action="store_true", help="overwrite an existing inventory directory")
    p.add_argument("--print-answers", action="store_true", help="only validate and print the answers (no files)")
    p.add_argument("--fresh", action="store_true",
                   help="interactive: ignore the answers remembered from the last run "
                        "(<output-dir>/" + LAST_ANSWERS + ")")
    args = p.parse_args(argv)

    try:
        given = load_answers(args.answers) if args.answers else {}
        given.update(parse_set(args.set))
        interactive = not args.non_interactive and sys.stdin.isatty()
        if not interactive and not args.non_interactive:
            raise SetupError("stdin is not a terminal: use --non-interactive with --answers/--set")
        last = None
        if interactive:
            print("fast-rdp-server setup. Press Enter to accept the [default].", file=sys.stderr)
            last = LastAnswers(Path(args.output_dir) / LAST_ANSWERS, fresh=args.fresh)
            if last.values:
                print(f"Defaults include your answers from the last run ({last.path}); "
                      "--fresh ignores them.", file=sys.stderr)
            print(file=sys.stderr)
        a = resolve(given, interactive, last=last)
        if args.print_answers:
            print(json.dumps(public_answers(a), indent=2))
            return 0
        password_file = args.vault_password_file or a.get("vault_password_file")
        if password_file:
            password_file = str(Path(os.path.expanduser(password_file)).resolve())
            if not os.path.isfile(password_file):
                raise SetupError(f"vault password file {password_file} not found")
        vault_bin = find_ansible_vault()
        vault_password = os.environ.get("FASTRDP_VAULT_PASSWORD")
        plaintext_ok = args.plaintext_vault
        if secrets_for(a) and not password_file and not vault_password:
            if vault_bin and interactive:
                while True:
                    vault_password = getpass.getpass("New ansible-vault password for vault.yml: ")
                    if vault_password and vault_password == getpass.getpass("  repeat: "):
                        break
                    print("  empty or not matching, again", file=sys.stderr)
            elif not vault_bin and interactive and not plaintext_ok:
                print("ansible-vault was not found.", file=sys.stderr)
                ans = input("Write vault.yml unencrypted (mode 0600) and encrypt it later? [y/N]: ")
                plaintext_ok = _bool(ans or "n")
                if not plaintext_ok:
                    raise SetupError("aborted: install ansible-core (ansible-vault) and re-run")
        inv_dir, vault_mode = generate(a, args.output_dir, args.force, password_file, vault_password,
                                       plaintext_ok, vault_bin)
        print(next_steps(a, inv_dir, vault_mode, password_file))
        return 0
    except SetupError as e:
        print(f"fastrdp-setup: {e}", file=sys.stderr)
        return 2
    except (KeyboardInterrupt, EOFError):
        print("\naborted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
