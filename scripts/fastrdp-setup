    Q("tls", "RDP certificate: self-signed (lab) / provided (PEM files)", v_choice("self-signed", "provided"),
      lambda a: "provided" if _is_prod(a) else "self-signed",
      help="Clients warn about a self-signed certificate. For production use a certificate\n"
           "for the FQDN from your CA (web access uses the same certificate)."),
    Q("tls_cert", "Certificate (PEM, full chain) on this machine", v_pem("cert"),
      when=lambda a: a.get("tls") == "provided"),
    Q("tls_key", "Private key (PEM) on this machine", v_pem("key"), when=lambda a: a.get("tls") == "provided"),
