class SetupError(Exception):
    pass


# ----------------------------------------------------------------------------- validators
# Each takes the raw answer (string from the prompt, or any JSON value from an answers
# file) and the answers so far; returns the normalised value or raises SetupError.

HOST_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
GROUP_RE = re.compile(r"^[^\s,:\"']+$")


def _list(value):
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return [str(v).strip() for v in value if str(v).strip()]
    return [v.strip() for v in str(value).replace(" ", ",").split(",") if v.strip()]


def _bool(value, _a=None):
    if isinstance(value, bool):
        return value
    v = str(value).strip().lower()
    if v in ("y", "yes", "true", "1", "on"):
        return True
    if v in ("n", "no", "false", "0", "off"):
        return False
    raise SetupError("answer yes or no")


def _str(value, _a=None):
    return "" if value is None else str(value).strip()


def v_choice(*choices):
    def check(value, _a=None):
        v = _str(value).lower()
        if v not in choices:
            raise SetupError("choose one of: " + ", ".join(choices))
        return v
    return check


def v_fqdn(value, _a=None):
    v = _str(value).lower().rstrip(".")
    if not HOST_RE.match(v):
        raise SetupError(f"{value!r} is not a fully qualified host name (e.g. rdp1.example.com)")
    return v


def v_hosts(value, a):
    hosts = [h.lower() for h in _list(value)]
    if not hosts:
        raise SetupError("at least one host is needed")
    if a.get("connection") == "local":
        return hosts
    return [v_fqdn(h) for h in hosts]


def v_name(value, _a=None):
    v = _str(value)
    if not NAME_RE.match(v):
        raise SetupError("use lower-case letters, digits, '-' and '_'")
    if v == "lab":
        raise SetupError("'lab' is the shipped example inventory; choose another name")
    return v


def v_user(value, _a=None):
    v = _str(value)
    if v and not re.match(r"^[A-Za-z_][A-Za-z0-9_.@-]*$", v):
        raise SetupError("not a valid user name")
    return v


def v_become_exe(value, _a=None):
    v = _str(value) or "sudo"
    if not re.match(r"^(/[A-Za-z0-9._/-]+|[A-Za-z0-9._-]+)$", v):
        raise SetupError("a program name such as sudo or sudo.ws, or an absolute path")
    return v


def v_realm(value, a):
    v = _str(value)
    if not re.match(r"^[A-Z0-9]([A-Z0-9-]*[A-Z0-9])?(\.[A-Z0-9]([A-Z0-9-]*[A-Z0-9])?)+$", v):
        raise SetupError("realms are upper case DNS-style names, e.g. EXAMPLE.COM")
    if a.get("identity_provider") == "ad" and v != a.get("domain", "").upper():
        raise SetupError(f"an AD realm is the DNS domain in upper case: {a.get('domain', '').upper()}")
    return v


def v_groups(value, _a=None):
    groups = _list(value)
    for g in groups:
        if not GROUP_RE.match(g):
            raise SetupError(f"invalid group name {g!r}")
    return groups


def v_networks(value, _a=None):
    nets = []
    for n in _list(value):
        try:
            nets.append(str(ipaddress.ip_network(n, strict=True)))
        except ValueError as e:
            raise SetupError(f"invalid network {n!r} (CIDR such as 10.0.0.0/8): {e}") from None
    return nets


def v_desktops(value, _a=None):
    desks = []
    for d in _list(value):
        d = d.lower()
        if d not in ALL_DESKTOPS:
            raise SetupError(f"unknown desktop {d!r}; known: {' '.join(ALL_DESKTOPS)}")
        if d not in desks:
            desks.append(d)
    if not desks:
        raise SetupError("choose at least one desktop")
    return desks


def v_default_desktop(value, a):
    v = _str(value).lower()
    if v not in a["desktops"]:
        raise SetupError("the default desktop must be one of: " + ", ".join(a["desktops"]))
    return v


def v_url(value, _a=None):
    v = _str(value).rstrip("/")
    if not re.match(r"^https?://[A-Za-z0-9.-]+(:\d+)?(/\S*)?$", v):
        raise SetupError("expected a URL like https://host.example.com/path")
    return v


def v_https_url(value, a=None):
    v = v_url(value, a)
    if not v.startswith("https://"):
        raise SetupError("use https:// (credentials and tokens go over this connection)")
    return v


def v_file(optional):
    def check(value, _a=None):
        v = _str(value)
        if not v:
            if optional:
                return ""
            raise SetupError("a path is needed")
        p = Path(os.path.expanduser(v)).resolve()
        if not p.is_file():
            raise SetupError(f"{p} does not exist (paths are on this admin machine)")
        if not os.access(p, os.R_OK):
            raise SetupError(f"{p} is not readable")
        return str(p)
    return check


def v_pem(kind):
    base = v_file(optional=False)

    def check(value, a=None):
        p = base(value, a)
        head = Path(p).read_text(errors="replace")
        marker = "-----BEGIN CERTIFICATE-----" if kind == "cert" else "PRIVATE KEY-----"
        if marker not in head:
            raise SetupError(f"{p} is not a PEM {'certificate' if kind == 'cert' else 'private key'}")
        return p
    return check


def v_secret(value, _a=None):
    v = "" if value is None else str(value)
    if not v:
        raise SetupError("a value is needed")
    if "\n" in v:
        raise SetupError("single line only")
    return v


def v_checksum(value, _a=None):
    v = _str(value).lower()
    if v and not re.match(r"^sha256:[0-9a-f]{64}$", v):
        raise SetupError("expected sha256:<64 hex digits>")
    return v


def v_web_url(value, a=None):
    if _str(value) == ROLE_DEFAULTS["fastrdp_web_public_url"]:
        return ROLE_DEFAULTS["fastrdp_web_public_url"]
    return v_https_url(value, a)


def v_tls_logins(value, a):
    v = _bool(value)
    if not v and a.get("mfa_mode") == "otp":
        raise SetupError("MFA mode 'otp' needs TLS logins (NLA has no channel for an OTP)")
    return v


def v_web_enabled(value, a):
    v = _bool(value)
    if not v and _web_approval(a):
        raise SetupError(f"MFA mode '{a['mfa_mode']}' needs browser access (the approval page is on the web gateway)")
    return v


def v_seconds(lo, hi):
    def check(value, _a=None):
        v = _str(value)
        if isinstance(value, bool) or not re.match(r"^[0-9]+$", v) or not lo <= int(v) <= hi:
            raise SetupError(f"whole seconds from {lo} to {hi}")
        return int(v)
    return check


def v_approval_timeout(value, a=None):
    # 10..510 as in roles/common: plus the session start it must fit the proxy's 600 s maximum
    return v_seconds(10, 600 - SESSION_START_TIMEOUT)(value, a)


# Same item syntax and refusals as roles/common and the broker (config.py KDC_EVIDENCE_ITEM,
# KDC_EVIDENCE_NOT_MFA): these SIDs and "hardened" are in the tickets of password logons too.
KDC_EVIDENCE_ITEM_RE = re.compile(r"^(ind:[!-~]{1,64}|sid:S-1-[0-9]{1,15}(-[0-9]{1,10}){1,15})\Z")
KDC_EVIDENCE_NOT_MFA_RE = re.compile(
    r"^(ind:hardened|sid:S-1-18-[12]|sid:S-1-1-0|sid:S-1-5-11|sid:S-1-5-32-545|sid:S-1-5-21-.*-513)\Z")


def v_kdc_evidence(value, _a=None):
    items = []
    for i in _list(value):
        if not KDC_EVIDENCE_ITEM_RE.match(i):
            raise SetupError(f"invalid item {i!r}: use ind:<indicator> or sid:S-1-... (e.g. ind:pkinit, sid:S-1-18-4)")
        if KDC_EVIDENCE_NOT_MFA_RE.match(i):
            raise SetupError(f"{i} is in the tickets of password logons too, it is no second factor")
        if i not in items:
            items.append(i)
    return items


# ----------------------------------------------------------------------------- questions

def probe_apt_repo(url=APT_REPO_URL, timeout=5):
    """True if the APT repository has a suite for a supported release."""
    for suite in SUPPORTED_SUITES:
        try:
            req = urllib.request.Request(f"{url}/dists/{suite}-stable/InRelease", method="HEAD")
            with urllib.request.urlopen(req, timeout=timeout) as r:   # noqa: S310 (fixed https URL)
                if r.status == 200:
                    return True
        except (urllib.error.URLError, OSError, ValueError):
            pass
    return False


def _default_install_method(a):
    probe = a.get("_apt_probe")
    if probe is None:
        return "build"
    return "apt" if probe else "build"


class Q:
    def __init__(self, key, prompt, validate, default=None, when=None, secret=False, help=None,
                 ask=None):
        self.key, self.prompt, self.validate = key, prompt, validate
        self.default = default          # value or callable(answers)
        self.when = when or (lambda a: True)
        self.ask = ask or (lambda a: True)   # False: not asked interactively, default used
        self.secret, self.help = secret, help

    def default_for(self, a):
        return self.default(a) if callable(self.default) else self.default


def _is_prod(a):
    return a.get("profile") == "production"


def _join(a):
    return a.get("identity_provider") in ("ad", "ipa")


def _mfa(a):
    return a.get("mfa_mode", "none") != "none"


def _web(a):
    return bool(a.get("web_enabled"))


def _pi(a):
    """MFA modes that use privacyIDEA (web: approval on the web gateway only)."""
    return a.get("mfa_mode", "none") in ("otp", "push", "otp_or_push", "push_or_web")


def _web_approval(a):
    return a.get("mfa_mode", "none") in ("web", "push_or_web")


def _audio(a):
    return bool(a.get("audio", True))


QUESTIONS = [
    Q("profile", "Deployment type (lab / production)", v_choice("lab", "production"), "lab",
      help="lab: self-signed certificate, everyone in the directory may log in.\n"
           "production: asks for certificates, allowed groups, MFA and hardening options."),
    Q("hosts", "RDP server(s), fully qualified, comma-separated", v_hosts,
      help="Clients must connect to exactly this FQDN (Kerberos service TERMSRV/<fqdn>)."),
    Q("name", "Inventory name (ansible/inventories/<name>)", v_name,
      lambda a: re.sub(r"[^a-z0-9_-]", "-", a["hosts"][0].split(".")[0])),
    Q("ssh_user", "SSH user on the host(s) (empty = from ~/.ssh/config)", v_user,
      lambda a: getpass.getuser()),
    Q("become_password", "Does this user need a password for sudo? (y/n)", _bool,
      lambda a: False, when=lambda a: a.get("ssh_user") != "root"),
    Q("become_exe", "sudo program on the host(s) (sudo / sudo.ws)", v_become_exe, "sudo",
      when=lambda a: bool(a.get("become_password")),
      help="Ubuntu 26.04's sudo is sudo-rs, which never shows the password prompt Ansible waits\n"
           "for (preflight: 'Timeout waiting for privilege escalation prompt'). Answer sudo.ws\n"
           "there: classic sudo, installed next to it. Debian 13: sudo."),
    Q("identity_provider", "Directory: ad (Samba/Windows AD) / ipa (FreeIPA) / none (MIT KDC, keytab provided)",
      v_choice("ad", "ipa", "none"), "ad",
      help="ad and ipa join the host automatically. With none you provide the TERMSRV keytab\n"
           "and /etc/sssd/sssd.conf yourself."),
    Q("domain", "DNS domain of the realm", v_fqdn,
      lambda a: a["hosts"][0].split(".", 1)[1] if "." in a["hosts"][0] else "",
      help="The KDCs are found via DNS SRV records (_kerberos._tcp.<domain>)."),
    Q("realm", "Kerberos realm", v_realm, lambda a: a["domain"].upper()),
    Q("join_user", "Join account", _str,
      lambda a: "Administrator" if a["identity_provider"] == "ad" else "admin", when=_join),
    Q("join_password", "Join password (stored in the encrypted vault)", v_secret, when=_join, secret=True),
    Q("termsrv_keytab", "TERMSRV keytab on this machine (empty = already on the host)", v_file(True), "",
      when=lambda a: a["identity_provider"] == "none",
      help="Keytab with TERMSRV/<fqdn>@REALM keys, installed as /etc/fastrdp/termsrv.keytab."),
    Q("allow_groups", "Groups allowed to log in (comma-separated, empty = every directory user)", v_groups,
      lambda a: ["rdp-users"] if _is_prod(a) else []),
    Q("sssd_fully_qualified_names", "Directory users as user@domain (fully qualified names)? (y/n)",
      _bool, False, ask=_is_prod,
      help="n: users are 'alice' (familiar; a local account 'alice' would take the place of\n"
           "the directory user). y: users are 'alice@<domain>' everywhere (ls, sudoers, ACLs),\n"
           "and no local account can stand in for them. Home directories stay /home/alice.\n"
           "Provider none: your sssd.conf must set use_fully_qualified_names to match."),
    Q("ad_gpo_access_control", "AD GPO logon-right check: permissive / enforcing / disabled",
      v_choice("permissive", "enforcing", "disabled"), "permissive",
      when=lambda a: a["identity_provider"] == "ad", ask=_is_prod,
      help="permissive only logs denials. Check the logs, then switch to enforcing."),
    Q("desktops", "Desktops (comma-separated)", v_desktops, ["xfce"],
      help="X11 (xrdp):        " + " ".join(X11_DESKTOPS) + "\n"
           "Wayland:           " + " ".join(WAYLAND_DESKTOPS) + "  (need more RAM/CPU, GPU recommended)\n"
           "wlroots (in xrdp): " + " ".join(WLROOTS_DESKTOPS)),
    Q("default_desktop", "Default desktop", v_default_desktop, lambda a: a["desktops"][0]),
    Q("gpu", "GPU: auto / nvidia / mesa (Intel, AMD) / none", v_choice("auto", "nvidia", "mesa", "none"), "auto"),
    Q("lan_networks", "Client networks on the LAN (CIDRs, comma-separated, empty = none)", v_networks, [],
      ask=_is_prod,
      help="X11 (xrdp) sessions of clients that ask for auto-detection (mstsc's default) get a\n"
           "bitrate cap for WAN links. Clients from these networks get the uncapped LAN profile.\n"
