#!/usr/bin/make -f
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Marcel Ritter <marcel@linux-ng.de>
# fastrdp-freerdp3: FreeRDP from third_party/sources.yml + patches/freerdp/series,
# built by third_party/build-freerdp.sh (prefix /opt/fastrdp, RPATH $ORIGIN/../lib).
# The build tree is assembled by packaging/ci/prepare-vendored.sh:
#   src/freerdp/       patched upstream source (third_party/fetch.sh)
#   third_party/       the build scripts
#   debian/vendored.mk upstream versions

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include debian/vendored.mk

PREFIX := /opt/fastrdp

%:
	dh $@

# Configure, build and DESTDIR install are one step in the shared build script.
override_dh_auto_configure override_dh_auto_build override_dh_auto_test:

override_dh_auto_install:
	third_party/build-freerdp.sh src/freerdp $(CURDIR)/debian/tmp
	test -x debian/tmp$(PREFIX)/bin/freerdp-proxy
	test "$$(PKG_CONFIG_PATH= PKG_CONFIG_SYSROOT_DIR= PKG_CONFIG_LIBDIR=debian/tmp$(PREFIX)/lib/pkgconfig \
		pkg-config --modversion freerdp3)" = "$(FREERDP_VERSION)"
	find debian/tmp -name '*.la' -delete

# The build tree is regenerated by prepare-vendored.sh for every build.
override_dh_auto_clean:

# Libraries are private to /opt/fastrdp (DT_RPATH $ORIGIN/../lib): resolve them in
# the package itself, and publish no shlibs file and no ldconfig trigger.
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/fastrdp-freerdp3$(PREFIX)/lib

override_dh_makeshlibs:
