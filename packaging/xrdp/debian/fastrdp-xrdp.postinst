#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Marcel Ritter <marcel@linux-ng.de>
set -e

#DEBHELPER#

DEFAULTS=/usr/share/fastrdp-xrdp/default-config

if [ "$1" = configure ]; then
    # Site configuration (xrdp.ini, sesman.ini, gfx.toml, startwm.sh, xorg.conf, PAM
    # stack): not conffiles, because fastrdp (Ansible roles or admin) replaces them and
    # dpkg would ask on every upgrade. Upstream's versions only where a file is missing;
    # existing files, also the obsolete conffiles of fastrdp-xrdp before 0.10.6.1+xorgxrdp0.10.5-2,
    # are left alone.
    (cd "$DPKG_ROOT$DEFAULTS" && find . -type f) | while read -r f; do
        f=${f#.}
        if [ ! -e "$DPKG_ROOT$f" ] && [ ! -L "$DPKG_ROOT$f" ]; then
            mkdir -p "$DPKG_ROOT$(dirname "$f")"
            cp -p "$DPKG_ROOT$DEFAULTS$f" "$DPKG_ROOT$f"
        fi
    done

    # Host-specific secrets, never shipped in the package (same as the Ansible role).
    if [ ! -e "$DPKG_ROOT/etc/xrdp/cert.pem" ] && [ ! -e "$DPKG_ROOT/etc/xrdp/key.pem" ]; then
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
            -days 3650 -subj /CN=fastrdp-xrdp-backend \
            -keyout "$DPKG_ROOT/etc/xrdp/key.pem" -out "$DPKG_ROOT/etc/xrdp/cert.pem" 2>/dev/null
        chown root:xrdp "$DPKG_ROOT/etc/xrdp/key.pem"
        chmod 0640 "$DPKG_ROOT/etc/xrdp/key.pem"
        chmod 0644 "$DPKG_ROOT/etc/xrdp/cert.pem"
    fi
    if [ ! -e "$DPKG_ROOT/etc/xrdp/rsakeys.ini" ]; then
        xrdp-keygen xrdp "$DPKG_ROOT/etc/xrdp/rsakeys.ini" >/dev/null
        chown root:xrdp "$DPKG_ROOT/etc/xrdp/rsakeys.ini"
        chmod 0640 "$DPKG_ROOT/etc/xrdp/rsakeys.ini"
    fi
fi
