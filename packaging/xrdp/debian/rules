#!/usr/bin/make -f
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Marcel Ritter <marcel@linux-ng.de>
# fastrdp-xrdp: xrdp + xorgxrdp from third_party/sources.yml + patches/xrdp/series,
# built by third_party/build-xrdp.sh (prefix /usr, sysconfdir /etc, --enable-ffmpeg).
# The build tree is assembled by packaging/ci/prepare-vendored.sh:
#   src/xrdp/, src/xorgxrdp/  patched upstream sources (third_party/fetch.sh)
#   third_party/              the build scripts
#   debian/vendored.mk        upstream versions

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include debian/vendored.mk

%:
	dh $@

# Configure, build and DESTDIR install are one step in the shared build script
# (which runs autoreconf itself).
override_dh_auto_configure override_dh_auto_build override_dh_auto_test:
override_dh_update_autotools_config override_dh_autoreconf:

override_dh_auto_install:
	# build-xrdp.sh checks --enable-x264/--enable-ffmpeg itself (from the generated
	# options header: the binary cannot run here, its RUNPATH is /usr/lib/xrdp).
	third_party/build-xrdp.sh src/xrdp src/xorgxrdp $(CURDIR)/debian/tmp
	# Host secrets that xrdp's install hooks may create: generated in postinst.
	rm -f debian/tmp/etc/xrdp/rsakeys.ini debian/tmp/etc/xrdp/cert.pem debian/tmp/etc/xrdp/key.pem
	# Development files (only needed to build xorgxrdp) and libtool archives.
	rm -rf debian/tmp/usr/include debian/tmp/usr/lib/pkgconfig debian/tmp/usr/lib/*/pkgconfig
	find debian/tmp \( -name '*.la' -o -name '*.a' \) -delete
	rm -rf debian/tmp/var/run debian/tmp/run

# The build tree is regenerated by prepare-vendored.sh for every build.
override_dh_auto_clean:

# xrdp's stock xrdp.ini listens on 3389 on all addresses; fastrdp runs it on
# loopback behind the proxy. Enable it only once /etc/xrdp is configured.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

# Private libraries in /usr/lib/xrdp: no shlibs file, no ldconfig trigger.
override_dh_makeshlibs:

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/fastrdp-xrdp/usr/lib/xrdp

# xorgxrdp is an Xorg video driver: depend on the video driver ABI of the
# xserver-xorg-core it was built against (what dh_xsf_substvars does for
# xserver-xorg-video-* packages).
XORG_VIDEO_DEP := $(or $(shell cat /usr/share/xserver-xorg/videodrvdep 2>/dev/null),xserver-xorg-core)

override_dh_gencontrol:
	dh_gencontrol -- -Vfastrdp:XrdpVersion=$(XRDP_VERSION) -Vfastrdp:XorgxrdpVersion=$(XORGXRDP_VERSION) \
		"-Vfastrdp:XorgVideoABI=$(XORG_VIDEO_DEP)"
