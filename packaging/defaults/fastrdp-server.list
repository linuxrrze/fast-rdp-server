# Installed as /usr/share/fastrdp-server/defaults.list; read by fastrdp-defaults(8):
#   DEST MODE OWNER GROUP SOURCE [if=PATH] [also=FILE]
/etc/nftables.d/fastrdp.nft 0644 root root /usr/share/fastrdp-server/defaults/etc/nftables.d/fastrdp.nft
/etc/krb5.conf.d/fastrdp 0644 root root /usr/share/fastrdp-server/defaults/etc/krb5.conf.d/fastrdp
# sssd reads conf.d only when it is root-owned and 0600 (trigger on /usr/sbin/sssd)
/etc/sssd/conf.d/50-fastrdp.conf 0600 root root /usr/share/fastrdp-server/defaults/etc/sssd/conf.d/50-fastrdp.conf if=/usr/sbin/sssd
